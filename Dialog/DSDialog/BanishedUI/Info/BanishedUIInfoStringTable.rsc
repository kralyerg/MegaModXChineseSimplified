StringTable Info
{
	Entry _strings
	[
		{
			String _name = "HealthHappiness";
			String _text = "健康与快乐";
		}
		{
			String _name = "HealthHappinessTitle1";
			String _text = "健康与快乐";
		}
		{
			String _name = "HealthHappinessTitle2";
			String _text = "——关于村民所患的疾病与病痛，以及他们的快乐与沮丧——";
		}
		{
			String _name = "column1text01";
			String _text = "在《Banished》中，健康与快乐通过图标向玩家展示（见右侧），可以是全镇平均数据，也可以在选中并查看某位居民的界面时单独显示。";
		}
		{
			String _name = "column1text02";
			String _text = "在游玩《Banished》时，让村庄保持满心（健康）或满星（快乐）有时并不困难。";
		}
		{
			String _name = "column1text03";
			String _text = "但在使用 DS 系列模组*后，居民会更频繁、更大幅度地受到各种导致不健康与不快乐因素的影响，这为玩家带来更具挑战性和互动性的游戏体验。";
		}
		{
			String _name = "column1text04";
			String _text = "*（仅当某些 DS 模组被置于其他同样会修改居民文件的模组之上时才会生效）。";
		}
		{
			String _name = "column1text05";
			String _text = "此时必须确保为居民提供充足的营养、精神及其他需求，同时也要更加重视城镇规划，以对抗各种负面的快乐影响因素。";
		}
		{
			String _name = "column1text06";
			String _text = "疾病与病症";
		}
		{
			String _name = "column1text07";
			String _text = "除了对居民健康与快乐的改动外，还有一些改动";
		}
		{
			String _name = "column1text07add";
			String _text = "涉及居民可能罹患疾病的种类及概率。当居民患上其中任何一种疾病时，都需要医院与医师/医生的救治。";
		}
		{
			String _name = "column1text08";
			String _text = "以下是疾病与病症列表：";
		}
		{
			String _name = "column1text09";
			String _text = "中风（卒中）";
		}
		{
			String _name = "column1text10";
			String _text = "萎缩症（肌肉萎缩）";
		}
		{
			String _name = "column1text11";
			String _text = "胆汁病（恶心反胃）";
		}
		{
			String _name = "column1text12";
			String _text = "黑热病（寄生虫病）";
		}
		{
			String _name = "column1text13";
			String _text = "血液中毒（败血症）";
		}
		{
			String _name = "column1text14";
			String _text = "骨折";
		}
		{
			String _name = "column1text15";
			String _text = "水痘";
		}
		{
			String _name = "column1text16";
			String _text = "霍乱";
		}
		{
			String _name = "column1text17";
			String _text = "腹泻";
		}
		{
			String _name = "column1text18";
			String _text = "白喉";
		}
		{
			String _name = "column1text19";
			String _text = "痢疾（血痢）";
		}
		{
			String _name = "column1text20";
			String _text = "心内膜炎（水精灵病）";
		}
		{
			String _name = "column1text21";
			String _text = "麦角中毒症（圣安东尼之火）";
		}
		{
			String _name = "column1text22";
			String _text = "淋病";
		}
		{
			String _name = "column1text23";
			String _text = "流感（汗热病）";
		}
		{
			String _name = "column1text24";
			String _text = "麻风病";
		}
		{
			String _name = "column1text25";
			String _text = "疟疾（间歇热）";
		}
		{
			String _name = "column1text26";
			String _text = "麻疹";
		}
		{
			String _name = "column1text27";
			String _text = "腮腺炎";
		}
		{
			String _name = "column1text28";
			String _text = "瘟疫（黑死病）";
		}
		{
			String _name = "column1text29";
			String _text = "肺炎";
		}
		{
			String _name = "column1text30";
			String _text = "猩红热";
		}
		{
			String _name = "column1text31";
			String _text = "瘰疬（国王之疾）";
		}
		{
			String _name = "column1text32";
			String _text = "坏血病";
		}
		{
			String _name = "column1text33";
			String _text = "天花（红色瘟疫）";
		}
		{
			String _name = "column1text34";
			String _text = "肺结核";
		}
		{
			String _name = "column1text35";
			String _text = "伤寒（斑疹伤寒）";
		}
		{
			String _name = "column1text36";
			String _text = "百日咳";
		}
		{
			String _name = "column1text37";
			String _text = "黄热病";
		}
		{
			String _name = "column1labelDeathLow";
			String _text = "死亡概率：不太可能";
		}
		{
			String _name = "column1labelDeathMed";
			String _text = "死亡概率：有可能";
		}
		{
			String _name = "column1labelDeathHigh";
			String _text = "死亡概率：常见";
		}
		{
			String _name = "column1labelAcqVeryLow";
			String _text = "患病概率：极低";
		}
		{
			String _name = "column1labelAcqLow";
			String _text = "患病概率：低";
		}
		{
			String _name = "column1labelAcqAvg";
			String _text = "患病概率：偶发";
		}
		{
			String _name = "column1labelAcqAbAvg";
			String _text = "患病概率：常见";
		}
		{
			String _name = "column1labelAcqHigh";
			String _text = "患病概率：高";
		}
		{
			String _name = "column1labelAcqVeryHigh";
			String _text = "患病概率：极高";
		}
		{
			String _name = "column1labelTransNo";
			String _text = "是否会传染？否";
		}
		{
			String _name = "column1labelTransYes";
			String _text = "是否会传染？是";
		}
		{
			String _name = "column2text01";
			String _text = "健康图标：";
		}
		{
			String _name = "column2text02";
			String _text = "居民的健康由多种因素决定：";
		}
		{
			String _name = "column2text03";
			String _text = "拥有包含各类食物（水果、谷物、蛋白质与蔬菜）的均衡饮食。";
		}
		{
			String _name = "column2text04";
			String _text = "草药师拥有充足的草药与药品供应。";
		}
		{
			String _name = "column2text05";
			String _text = "医生以及充足的接诊能力，用于迅速预防疾病。";
		}
		{
			String _name = "column2text06";
			String _text = "贸易船只与游牧民带来疾病的风险很高，若没有预防措施，将会大幅降低居民的健康水平。";
		}
		{
			String _name = "column2text07";
			String _text = "同样，若缺少草药师提供医治，或草药与药品供应不足，常见疾病将在村民中蔓延。当居民过度不健康时，更容易携带并传播致命疾病，情况将变得十分令人担忧。";
		}
		{
			String _name = "column2text08";
			String _text = "随着气温下降，让居民保持温暖至关重要。这不仅意味着家庭需要充足的燃料供应，还需要有完善的道路，让居民能够迅速抵达温暖的场所。";
		}
		{
			String _name = "column2text09";
			String _text = "为居民提供健康加成的建筑可通过其范围颜色加以区分：";
		}
		{
			String _name = "column2text10";
			String _text = "草药师擅长采摘、配制并施用药草，用于治疗居民一生中可能罹患的各种小病小痛。";
		}
		{
			String _name = "column2text11";
			String _text = "医院与医生则用于治疗具有传染性或致命性的疾病，以及骨折等较为复杂的病症（见左侧列表）。";
		}
		{
			String _name = "column3text01";
			String _text = "快乐图标：";
		}
		{
			String _name = "column3text02";
			String _text = "居民的快乐由建筑所提供的以下正面类别构成，可通过各自对应的范围颜色轻松辨别：";
		}
		{
			String _name = "column3text03";
			String _text = "安全";
		}
		{
			String _name = "column3text04";
			String _text = "商品";
		}
		{
			String _name = "column3text05";
			String _text = "精神";
		}
		{
			String _name = "column3text06";
			String _text = "娱乐";
		}
		{
			String _name = "column3text07";
			String _text = "酒水";
		}
		{
			String _name = "column3text08";
			String _text = "其他";
		}
		{
			String _name = "column3text09";
			String _text = "此外，嘈杂、恶臭或危险的建筑有时还会带来一种负面影响：";
		}
		{
			String _name = "column3text10";
			String _text = "负面影响";
		}
		{
			String _name = "column3text11";
			String _text = "对于不快乐的居民来说，沮丧会变得非常真实，他们会更频繁地闲逛，生产效率也随之下降。";
		}
		{
			String _name = "column3text12";
			String _text = "如同陷入恶性循环：他们完成的工作越少，就会变得越不快乐。";
		}
		{
			String _name = "column3text13";
			String _text = "通过消防水井，乃至瞭望塔与城墙，让居民感到安全。";
		}
		{
			String _name = "column3text14";
			String _text = "市场、商人与贸易站，以及一些生产类建筑，能为居民带来商品类快乐。";
		}
		{
			String _name = "column3text15";
			String _text = "通过小教堂及其他礼拜祈祷场所，以及公墓等居民可以悼念逝者的地方，满足他们的精神需求。";
		}
		{
			String _name = "column3text16";
			String _text = "娱乐类快乐分为两种类别，由其范围颜色加以区分：";
		}
		{
			String _name = "column3text17";
			String _text = "酒水、旅店与酒馆。居民喜爱饮酒及酒馆生活，请让酒窖和酒馆保持充足库存。";
		}
		{
			String _name = "column3text18";
			String _text = "其他娱乐类快乐可来自剧院、纪念碑或其他与酒水无关的建筑。";
		}
		{
			String _name = "column3text19";
			String _text = "带有负面影响的建筑，其范围内的居民都会受到负面影响。通过合理规划城镇，在这些生产类建筑周围布置正面影响建筑，可以确保工人不会变得过度不快乐。";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

StringTable InfoHouseholdFuels
{
	Entry _strings
	[
		{
			String _name = "HouseholdFuels";
			String _text = "家用燃料";
		}
		{
			String _name = "HouseholdFuelsTitle1";
			String _text = "家用燃料";
		}
		{
			String _name = "HouseholdFuelsTitle2";
			String _text = "——关于居民用于家庭取暖的燃料——";
		}
		{
			String _name = "column1text01a";
			String _text = "住房的供暖与保温所用的屋顶和墙壁同样重要。壁炉是家的核心所在，居民在这里取暖并烹饪食物。";
		}
		{
			String _name = "column1text01b";
			String _text = "根据住房类型的不同，只有气温低于某一数值时才需要燃料。例如，原版的木屋与石屋在气温为 50 华氏度及以下时需要燃料来保持居民温暖（这体现了住房的保温质量，即能够抵御更低温度的能力）。";
		}
		{
			String _name = "column1text01c";
			String _text = "原版住房保暖程度的差异，来自于家用燃料所能提供的热量与持续时间（即壁炉/炉火的效率）。木屋的保暖评级为 60，而石屋的保暖评级为 90，因此石屋能用更少的燃料获得更多的热量。";
		}
		{
			String _name = "valueTip";
			String _text = "产品价值";
		}
		{
			String _name = "valueTolTip";
			String _text = "产品价值：该产品的价值会波动，因此商人可能会在此价格区间内出价收购或出售";
		}
		{
			String _name = "weightTip";
			String _text = "产品重量";
		}
		{
			String _name = "quantityTip";
			String _text = "受教育或未受教育工人所生产的产品数量";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "由以下材料制成：";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "或：";
		}
		{
			String _name = "Firewood00";
			String _text = "柴火";
		}
		{
			String _name = "Firewood00Tip";
			String _text = "柴火的生产与储存受“燃料：家用”上限的限制。无论是否受过教育的伐木工，每根原木都可制成 6 份柴火。";
		}
		{
			String _name = "Firewood01";
			String _text = "1 根原木";
		}
		{
			String _name = "Firewood01Tip";
			String _text = "每个周期，单根原木的投入成本为 5。无论是否受过教育的工人，都能获得 7 点总利润，即每份柴火 1.17 点利润。";
		}
		{
			String _name = "Firewood02";
			String _text = "2 份木料";
		}
		{
			String _name = "Firewood02Tip";
			String _text = "每个周期，木料的投入成本为 8。无论是否受过教育的工人，都能获得 4 点总利润，即每份柴火 0.67 点利润。";
		}
		{
			String _name = "FirewoodQty";
			String _text = "产出：6";
		}
		{
			String _name = "FirewoodValue";
			String _text = "2";
		}
		{
			String _name = "FirewoodWeight";
			String _text = "2";
		}
		{
			String _name = "column2text09";
			String _text = "木炭";
		}
		{
			String _name = "Charcoal00Tip";
			String _text = "木炭通过一种称为“热解”的热反应制成，其生产受“燃料：冶金”上限的控制。如果附近有木炭可用，居民也会用它来取暖。";
		}
		{
			String _name = "column2text10";
			String _text = "21 根原木";
		}
		{
			String _name = "Charcoal01Tip";
			String _text = "该方法每个周期的投入成本为 105。未受教育的工人可获得 133 点利润，即每份木炭 3.91 点；而受过教育的工人则可获得 280 点总利润，即每份木炭 5.09 点。";
		}
		{
			String _name = "CharcoalQty";
			String _text = "产出：34-55";
		}
		{
			String _name = "CharcoalValue";
			String _text = "7";
		}
		{
			String _name = "CharcoalWeight";
			String _text = "5";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

StringTable InfoLimits
{
	Entry _strings
	[
		{
