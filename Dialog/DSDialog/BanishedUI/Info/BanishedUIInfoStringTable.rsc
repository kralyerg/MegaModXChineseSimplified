StringTable InfoPotteryGlass
{
	Entry _strings
	[
		{
			String _name = "PotteryGlass";
			String _text = "陶器与玻璃";
		}
		{
			String _name = "PotteryGlassTitle1";
			String _text = "陶器、砖块、瓦片与玻璃制作";
		}
		{
			String _name = "PotteryGlassTitle2";
			String _text = "——关于用作器皿与皇冠玻璃的原始土料——";
		}
		{
			String _name = "column1text01";
			String _text = "陶器是居民日常生活中重要的手工制品与器具，可制成多种不同的物件：既可作为简易油灯，也是重要的建筑材料（尤其在矿井中），还可作为混合、储存和保存物品的容器。";
		}
		{
			String _name = "column1text02";
			String _text = "砖块与瓦片在建筑施工中的重要性不言而喻。在大多数情况下，它们比石料、木材与茅草更轻便、更耐用。而在住宅建筑中使用时，还能提升并增强房屋的保暖与蓄热能力。";
		}
		{
			String _name = "column1text03";
			String _text = "玻璃是一项了不起的创造；用于建筑窗户的皇冠玻璃有诸多益处：它能让更多光线透入，使房屋减少燃料消耗，人们也不再需要居住在阴暗潮湿的石屋之中。在生产类建筑中使用时，更充足的光线也能让工作完成得更快、质量更高。";
		}
		{
			String _name = "column1text04";
			String _text = "玻璃器皿与陶器一样，可制成用于混合与储存物品的容器，此外精炼坊也会用它来制作护身符。";
		}
		{
			String _name = "column1text05";
			String _text = "石灰这种材料的用途之广令人惊叹，它还可用于陶器与玻璃的生产。在制作陶器时，石灰可与沙子一起替代配方中的粘土；在制作玻璃时，石灰的作用与此类似，可作为粘合剂使玻璃更加坚固，同时还能减少沙子的用量。";
		}
		{
			String _name = "column2AreMadeFrom";
			String _text = "由以下材料制成：";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "由以下材料制成：";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "或：";
		}
		{
			String _name = "valueTip";
			String _text = "产品价值";
		}
		{
			String _name = "valueTolTip";
			String _text = "产品价值：该产品的价值会波动，因此商人可能会在此价格区间内出价收购或出售";
		}
		{
			String _name = "weightTip";
			String _text = "产品重量";
		}
		{
			String _name = "quantityTip";
			String _text = "受教育或未受教育工人所生产的产品数量";
		}
		{
			String _name = "column2text01";
			String _text = "陶器";
		}
		{
			String _name = "Pottery00Tip";
			String _text = "陶器是一种应用广泛的手工制品，在生产与建筑中为居民提供多种功能，其生产受“手工制品与器具”上限的控制。";
		}
		{
			String _name = "column2text02";
			String _text = "4 份粘土 + ";
		}
		{
			String _name = "column2text03";
			String _text = "1 份焦炭或木炭";
		}
		{
			String _name = "Pottery01Tip";
			String _text = "此方法每个周期的投入成本为 19-20（木炭-焦炭）。未受教育的工人可获得 4-5（焦炭-木炭）点总利润，只能产出 3 份陶器；而受过教育的工人则可产出 4 份陶器，获得 12-13 点总利润，即每份陶器 3-3.25 点。";
		}
		{
