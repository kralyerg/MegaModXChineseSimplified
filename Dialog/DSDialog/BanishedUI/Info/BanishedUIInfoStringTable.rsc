		}
		{
			String _name = "Silver01Tip";
			String _text = "此方法每个周期的投入成本为 23-24（木炭-焦炭）。未受教育的工人会亏损 2-3 点，且只能产出 1 份银；而受过教育的工人则可获得 18-19（焦炭-木炭）点总利润，即每份银 9-9.5 点。";
		}
		{
			String _name = "SilverQty";
			String _text = "产出：1-2";
		}
		{
			String _name = "SilverValue";
			String _text = "21";
		}
		{
			String _name = "SilverWeight";
			String _text = "21";
		}
		{
			String _name = "column2text19";
			String _text = "银锭";
		}
		{
			String _name = "SilverIngot00Tip";
			String _text = "技艺娴熟的工匠能够成功锻造出银锭，以更少的燃料处理更多的银，其作为货币的价值更高，生产同样受“银”上限的控制，以管理生产与积累。";
		}
		{
			String _name = "column2text20";
			String _text = "6 份银矿石 + ";
		}
		{
			String _name = "column2text21";
			String _text = "1 份焦炭或木炭";
		}
		{
			String _name = "SilverIngot01Tip";
			String _text = "此方法每个周期的投入成本为 55-56（木炭-焦炭）。未受教育的工人由于燃料量过少，无法维持炉温，会亏损 5-6 点，且只能产出 1 份银锭；而受过教育的熟练工人则可获得 44-45（焦炭-木炭）点总利润，即每份银锭 22-22.5 点。";
		}
		{
			String _name = "SilverIngotQty";
			String _text = "产出：1-2";
		}
		{
			String _name = "SilverIngotValue";
			String _text = "50";
		}
