StringTable InfoToolsCrafted
{
	Entry _strings
	[
		{
			String _name = "ToolsCrafted";
			String _text = "工具与器具";
		}
		{
			String _name = "Title1";
			String _text = "工具、手工制品与器具";
		}
		{
			String _name = "Title2";
			String _text = "——关于全体居民或熟练工匠所使用的工具与器具——";
		}
		{
			String _name = "column1text01";
			String _text = "工具对于建设一座繁荣的城镇发挥着至关重要的作用。全体居民所使用的工具（青铜工具、铁制工具、钢制工具等）是经济与日常生活所必需的。无论是伐木、垦荒、播种与收割、采矿还是打铁，这些最基本的任务都离不开工具的使用。";
		}
		{
			String _name = "column1text02";
			String _text = "每项任务或建筑都设有一个工作时间数值，表示完成该任务或一次生产周期所需花费的时间单位。与此同时，还有一个所需工作量数值，表示每个周期实际所需的体力劳动量，而这一数值会直接受到工具的影响，同时也会反过来影响工具。";
		}
		{
			String _name = "column1text03";
			String _text = "在右侧可以看到可用工具的列表，每种工具名称下方都有一个符号：";
		}
		{
			String _name = "column1text04";
			String _text = "该符号及其旁边的数字代表工具的质量，以及该工具在“损坏”之前所能完成的工作单位数。";
		}
		{
			String _name = "column1text05";
			String _text = "没有工具的居民，不仅生产物品的速度会大幅减慢，在采集和收获食物、伐木与劈柴时也会受到阻碍。如果建筑工没有工具，建筑施工同样会受到严重拖累。";
		}
		{
			String _name = "column1text06";
			String _text = "启用 DS 系列模组后，游戏中铁的生产不再像以往那样，只需从地表采集，或仅以极低成本便可从矿井中轻松产出。";
		}
		{
			String _name = "column1text07";
			String _text = "改动概览：";
		}
		{
			String _name = "column1text08";
			String _text = "——地图表面不再有天然铁可供拾取，取而代之的是分散在地貌各处的少量铁矿石、铜矿石与锡矿石。";
		}
		{
			String _name = "column1text08a";
			String _text = "——铜矿石与锡矿石在地表更为常见，铁矿石的数量则较少。";
		}
		{
			String _name = "column1text09";
			String _text = "——矿井只会产出矿石（以及煤炭），而不再直接产出天然金属（铁、铜等）。";
		}
		{
			String _name = "column1text09a";
			String _text = "——采矿生产如今需要消耗原木或木料，以及灯油或蜡烛。";
		}
		{
			String _name = "column1text10";
			String _text = "——铁矿石需要在熔炉中配合冶金燃料（焦炭或木炭）冶炼，才能产出铁。铜及其他金属与合金也是如此。";
		}
		{
			String _name = "column1text10a";
			String _text = "——焦炭来自对煤炭的开采与“烧制”，木炭则来自对原木的炭化烧制。";
		}
		{
			String _name = "column1text10b";
			String _text = "——地表铜矿石的加入，使得游戏早期可以轻松生产一种简单工具：仅用柴火即可冶炼出铜制工具（见右侧列表）。";
		}
		{
			String _name = "column1text10c";
			String _text = "——生产需要进一步锻造以增强强度的高品质工具（钢制工具与硬化工具），则需要使用冶金燃料。";
		}
		{
			String _name = "column1text11a";
			String _text = "工具可以在磨石处进一步加工打磨，成为“精良”版本。这类工具的名称后会标有星号（*），其耐久度比普通版本多 25 个工作单位。";
		}
		{
			String _name = "column1text11b";
			String _text = "若再使用亚麻籽油进行“上油”处理，这些工具的耐久度将额外提升 50 个工作单位。这类工具的名称后会标有星号与音调符号（*^）。";
		}
		{
			String _name = "column1text12";
			String _text = "此外还有其他类型的工具，属于手工制品与器具一类，供各类职业用于生产物品或建筑施工。";
		}
		{
			String _name = "column1text13a";
			String _text = "工具：石匠";
		}
		{
			String _name = "column1text13b";
			String _text = "作为从采石场开采石料的生产成本，“工具：石匠”的加入也降低了采石工此前面临的高因公殉职风险。它也被用作部分大型石制建筑的建造成本。";
		}
		{
			String _name = "column1text14a";
			String _text = "工具：渔夫";
		}
		{
			String _name = "column1text14b";
			String _text = "作为建造捕鱼地点的建造成本，在早期的 DS 系列模组中曾被称为“渔具”。";
		}
		{
			String _name = "column1text15a";
			String _text = "工具：猎人";
		}
		{
			String _name = "column1text15b";
			String _text = "作为建造狩猎地点的建造成本，在早期的 DS 系列模组中曾被称为“猎具”。";
		}
		{
			String _name = "column1text16a";
			String _text = "采集篮";
		}
		{
			String _name = "column1text16b";
			String _text = "作为建造采集地点的建造成本，同时也是采集橡子的生产成本。";
		}
		{
			String _name = "column1text17";
			String _text = "除上述内容外，以下手工制品在采矿、建筑施工以及工具改良方面也发挥着重要作用：";
		}
		{
			String _name = "column1text17a";
			String _text = "灯油";
		}
		{
			String _name = "column1text17b";
			String _text = "作为从矿井中开采矿石与矿物的生产成本，同时也用作建造隧道的建造成本。";
		}
		{
			String _name = "column1text18a";
			String _text = "蜡烛";
		}
		{
			String _name = "column1text18b";
			String _text = "作为从矿井中开采矿石与矿物的生产成本，同时也用作建造隧道及礼拜场所的建造成本。";
		}
		{
			String _name = "column1text19a";
			String _text = "亚麻籽油";
		}
		{
			String _name = "column1text19b";
			String _text = "亚麻籽油用于磨石处提升新工具的工作单位，可增强握柄的耐久度。在工具开刃获得的 25 个工作单位基础上，若同时进行此道额外工序，还可再获得 25 个工作单位。";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "由以下材料制成：";
		}
		{
			String _name = "column2MadeFromEither";
			String _text = "以下两者之一";
		}
		{
			String _name = "column2MadeFromEitherAnd";
			String _text = "并使用：";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "或：";
		}
		{
			String _name = "column2ToolsTITLE";
			String _text = "工具（供全体居民使用）：";
		}
		{
			String _name = "column2CraftedTITLE";
			String _text = "手工制品与器具：";
		}
		{
			String _name = "column2Usedby";
			String _text = "以上物品的使用者为：";
		}
		{
			String _name = "valueTip";
			String _text = "产品价值";
		}
		{
			String _name = "valueTolTip";
			String _text = "产品价值：该产品的价值会波动，因此商人可能会在此价格区间内出价收购或出售";
		}
		{
			String _name = "weightTip";
			String _text = "产品重量";
		}
		{
			String _name = "quantityTip";
			String _text = "受教育或未受教育工人所生产的产品数量";
		}
		{
			String _name = "qualityTip";
			String _text = "工具质量与使用寿命：数值越高，工具的质量越好，使用寿命也越长。";
		}
		{
			String _name = "CopperTool01";
			String _text = "铜制工具";
		}
		{
			String _name = "CopperTool00Tip";
			String _text = "铜制工具制作简单，铁匠无需先冶炼铜，便可在部分建筑中直接用铜矿石、原木和柴火制成铜制工具。";
		}
		{
