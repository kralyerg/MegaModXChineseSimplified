			String _text = "上限名称：";
		}
		{
			String _name = "titleribbonflag";
			String _text = "标志：";
		}
		{
			String _name = "titleribbonaka";
			String _text = "常见资源：（*悬停查看更多）";
		}
		{
			String _name = "column3text01";
			String _text = "所有水果、谷物、蛋白质与蔬菜";
		}
		{
			String _name = "column3text02";
			String _text = "柴火与木炭*";
		}
		{
			String _name = "column3text02Tip";
			String _text = "木炭的生产受“燃料：冶金”上限的限制，但也是一种居民可在家中使用的燃料。";
		}
		{
			String _name = "column3text03";
			String _text = "青铜工具、铁制工具、*";
		}
		{
			String _name = "column3text03Tip";
			String _text = "铜制工具、青铜工具、铁制工具、钢制工具、硬化工具。此外，所有工具还存在耐久度更高的“精良”*开刃版本，以及更耐用的“更精良”*开刃并上油版本。";
		}
		{
			String _name = "column3text04";
			String _text = "兽皮、羊毛与保暖外套、帆布外套";
		}
		{
			String _name = "column3text05";
			String _text = "草药、蜂王浆、耳烛";
		}
		{
			String _name = "column3text06";
			String _text = "麦芽酒、蜂蜜酒、烈性麦芽酒、本地酿酒";
		}
		{
			String _name = "column3text07";
			String _text = "马车零件、灯油、工具：石匠、*";
		}
		{
			String _name = "column3text07Tip";
			String _text = "蜂蜡、蜡烛、旗帜、采集篮、灯油、亚麻籽油、陶器、锡器、工具：渔夫、工具：猎人、工具：石匠、马车零件。";
		}
		{
			String _name = "column3text08";
			String _text = "羊毛、皮革、帆布、亚麻布";
		}
		{
			String _name = "column3text09";
			String _text = "（陈化中）、（已储存）与（已入库）的物资，*";
		}
		{
			String _name = "column3text09Tip";
			String _text = "橡子在加工为可食用状态之前，会按此上限（已储存）。";
		}
		{
			String _name = "column3text10";
			String _text = "木料*、瓦片、砖块";
		}
		{
			String _name = "column3text10Tip";
			String _text = "木料有时也被称为板材，但两者其实是同一种东西。";
		}
		{
			String _name = "column3text11";
			String _text = "原木";
		}
		{
			String _name = "column3text12";
			String _text = "石料";
		}
		{
			String _name = "column3text13";
			String _text = "铁制配件、铁砧、铜、锡、青铜";
		}
		{
			String _name = "column3text14";
			String _text = "铁";
		}
		{
			String _name = "column3text15";
			String _text = "玻璃、玻璃器皿";
		}
		{
			String _name = "column3text16";
			String _text = "焦炭、木炭*";
		}
		{
			String _name = "column3text17";
			String _text = "铁矿石、煤炭、铜矿石、锡矿石与银矿石";
		}
		{
			String _name = "column3text18";
			String _text = "粘土、石灰、沙子、肥料";
		}
		{
			String _name = "column3text19";
			String _text = "黄金、宝石";
		}
		{
			String _name = "column3text20";
			String _text = "银、银锭";
		}
		{
			String _name = "column3text21";
			String _text = "法新、银便士、诺布尔金币、*";
		}
		{
			String _name = "column3text21Tip";
			String _text = "法新、半便士、银便士、银格罗特、四分之一诺布尔金币、半诺布尔金币、诺布尔金币";
		}
		{
			String _name = "blank";
