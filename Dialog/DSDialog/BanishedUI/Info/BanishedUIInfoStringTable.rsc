		}
		{
			String _name = "column2text16";
			String _text = "银";
		}
		{
			String _name = "Silver00Tip";
			String _text = "奇妙的白银常被用作货币，是一种价值高、重量轻的物品，拥有自己独立的上限以控制生产与积累。";
		}
		{
