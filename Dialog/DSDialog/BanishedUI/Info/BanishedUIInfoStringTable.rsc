			String _text = "30";
		}
		{
			String _name = "CopperWeight";
			String _text = "25";
		}
		{
			String _name = "column2text01cTin";
			String _text = "锡";
		}
		{
			String _name = "Tin00Tip";
			String _text = "锡的生产受“金属、合金与锻造品”上限的控制，用于制作锡器，也是一种有贸易价值的商品。";
		}
		{
			String _name = "column2text02cTin";
			String _text = "5 份锡矿石 + ";
		}
		{
			String _name = "Tin01Tip";
			String _text = "此方法每个周期的投入成本为 39-41（木炭-焦炭）。未受教育的工人会亏损 3-5 点，且只能产出 1 份锡；而受过教育的工人则可获得 31-33（焦炭-木炭）点总利润，即每份锡 15.5-16.5 点。";
		}
		{
			String _name = "column2text04cTin";
