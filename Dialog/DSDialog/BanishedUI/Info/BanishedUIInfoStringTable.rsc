		}
	]

}

StringTable InfoMiningSmelting
{
	Entry _strings
	[
		{
			String _name = "MiningSmelting";
			String _text = "采矿与冶炼";
		}
		{
			String _name = "MiningSmeltingTitle1";
			String _text = "采矿、化验与冶金";
		}
		{
			String _name = "MiningSmeltingTitle2";
			String _text = "——关于矿石、矿物、石料与原始土料——";
		}
		{
			String _name = "MiningSmeltingTitle3";
			String _text = "——以及冶金所用的燃料与助熔剂——";
		}
		{
			String _name = "column1text01";
			String _text = "铁，也就是天然纯铁，即便在矿物界中确实存在，也极为稀少。如今它已不再能作为一种可直接从地表开采或采集的金属获得。取而代之的是开采铁矿石：大多数铁矿石来自矿井，但在游戏开局时，地图表面也存在少量、有限的矿石可供拾取。这是对铁的生产流程所做的一项写实性改动。";
		}
		{
			String _name = "column1text01a";
			String _text = "采矿（以及采石）在游戏中历来是一项危险的职业，如今通过增加额外成本，在一定程度上降低了这种危险性。采矿的成本较高，每个周期至少需要消耗一根原木或一份木料。更深、更大的矿井运作时可能还需要灯油或蜡烛。";
		}
		{
			String _name = "column1text01b";
			String _text = "虽然任何使用普通工具的劳工都能从地表获取石料，但如今采石开凿每个周期都需要使用专用器具——“工具：石匠”，这是一种在铁匠铺制作的手工制品与器具。与矿工一样，采石工如今因公殉职的概率也有所降低。";
		}
		{
			String _name = "column1text02";
			String _text = "铁矿石需要在高温熔炉中冶炼，以去除杂质并转化为最坚硬的金属——铁。";
		}
		{
			String _name = "column1text02a";
			String _text = "铁矿石";
		}
		{
			String _name = "column1text02b";
			String _text = "铁矿石主要通过开采获得，但地表也能找到少量。铁矿石没有固定的形态，外形极不规则，通常呈铁锈色。正是这种颜色揭示了其中所含的铁量，也是熔点最低、最易冶炼的铁矿石。";
		}
		{
			String _name = "column1text02c";
			String _text = "每次开采可获得 3-5 份铁矿石。";
		}
		{
			String _name = "column1text02copper";
			String _text = "铜矿石同样需要高温熔炉冶炼，才能转化为固态金属铜。";
		}
		{
			String _name = "column1text02coppera";
			String _text = "铜矿石";
		}
		{
			String _name = "column1text02copperb";
			String _text = "铜矿石主要通过开采获得，但地表也能找到大量。铜矿石刚被开采出来时，有时呈深邃的红蓝色，但往往还未运出地表便已氧化，呈现出美丽的蓝绿色泽。";
		}
		{
			String _name = "column1text02copperc";
			String _text = "每个周期可获得 3-5 份铜矿石。";
		}
		{
			String _name = "column1text02tin";
			String _text = "锡矿石需要熔炉冶炼才能转化为固态金属锡，此外它还可与铜矿石一起锻造成青铜。";
		}
		{
			String _name = "column1text02tina";
			String _text = "锡矿石";
		}
		{
			String _name = "column1text02tinb";
			String _text = "锡矿石通过开采获得，地表也能找到一定数量。含锡量最高的锡矿石呈黑色或深色，形状呈多面体但整体不规则，表面常常十分光亮，通常可在河岸的冲积层中找到。";
		}
		{
			String _name = "column1text02tinc";
			String _text = "每个周期可获得 3-5 份锡矿石。";
		}
		{
			String _name = "column1text03";
			String _text = "银矿石同样需要冶炼，但须在精炼炉中以更低的温度、更慢的速度进行，才能提炼出纯银。";
		}
		{
			String _name = "column1text02silvera";
			String _text = "银矿石";
		}
		{
			String _name = "column1text02silverb";
			String _text = "银矿石只能通过开采获得，虽然有时能找到极为纯净的天然形态，但这种价值其实微不足道，因为其中必定含有硫与砷。因此，矿中所采的银都必须与不够纯净的矿石一同冶炼。";
		}
		{
			String _name = "column1text02silverc";
			String _text = "每个周期可获得 3-5 份银矿石。";
		}
		{
			String _name = "column1text03Gold1";
			String _text = "黄金，在所有金属中，它是最常以天然形态存在的，不含硫与砷。据我所知，没有任何矿石中黄金是其最主要的金属成分。市面上确实有几种矿石冠以此名出售，但经过严格检验，发现它们并非如此。有时，许多人被这些矿石带红黄色的外观所迷惑，误以为其中含有黄金，便将其误认作金矿石。然而，我从未见过有人因此而真正致富，或从中熔炼出多少黄金。";
		}
		{
			String _name = "column1text04";
			String _text = "要让铁匠的熔炉或锻炉达到足以冶炼和提取矿石的高温，需要燃烧温度更高、燃烧时间比柴火或煤炭更久的燃料（这两者杂质过多，燃烧不稳定且过快）。如今，冶金燃料在冶金的各个环节中都是必不可少的：";
		}
		{
			String _name = "column1text05";
			String _text = "木炭";
		}
		{
			String _name = "column1text05a";
			String _text = "木炭由原木制成，以原始的炭堆方式烧制，或使用炭窑烧制（即将推出）。";
		}
		{
			String _name = "column1text05b";
			String _text = "原木在缺氧条件下被加热，开始进行热解（即炭化），从而去除杂质，每投入 21 根原木，约可产出 34-55 份木炭。";
		}
		{
			String _name = "column1text06";
			String _text = "焦炭";
		}
		{
			String _name = "column1text06a";
			String _text = "焦炭由煤炭制成，烧制方式与木炭类似：以原始的堆煤炉灶方式烧制（即将推出），将煤堆起并覆土焖烧，或使用蜂窝状焦炭炉可更快产出。";
		}
		{
			String _name = "column1text06b";
			String _text = "该工艺需要 21 份开采的煤炭，约可产出 21-34 份焦炭。";
		}
		{
			String _name = "column1text08";
			String _text = "金属的锻造过程迅速，且需要在高温条件下完成，这意味着所用矿石的数量往往会大于最终产出，造成较多损耗。";
		}
		{
			String _name = "column1text09";
			String _text = "在熔炉中加入助熔剂与矿石和燃料一同冶炼，可使所需矿石用量减半，同时保持相同的产出：";
		}
		{
			String _name = "column1text10";
			String _text = "石灰（亦称生石灰）";
		}
		{
			String _name = "column1text10a";
			String _text = "石灰在一种外形类似焦炭炉的炉窑中烧制而成，由质地较软（含钙量较高）的石料制成。石料被堆放在炉中，用燃料加热，直至发生反应，变为灰白色粉末。";
		}
		{
			String _name = "column1text10b";
			String _text = "一块大型石料配合燃料，大约可产出 5-8 份石灰。";
		}
		{
			String _name = "column1text10c";
			String _text = "在熔炉中冶炼金属时使用石灰，可与矿石发生反应，帮助分离杂质。石灰也可用作建筑材料，作为强力粘合剂使用，同时还能提升建筑的保温性能。";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "由以下材料制成：";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "或：";
		}
		{
			String _name = "valueTip";
			String _text = "产品价值";
		}
		{
			String _name = "valueTolTip";
			String _text = "产品价值：该产品的价值会波动，因此商人可能会在此价格区间内出价收购或出售";
		}
		{
			String _name = "weightTip";
			String _text = "产品重量";
		}
		{
			String _name = "quantityTip";
			String _text = "受教育或未受教育工人所生产的产品数量";
		}
		{
			String _name = "column2text01";
			String _text = "铁";
		}
		{
			String _name = "Iron00Tip";
			String _text = "铁是所有金属中最常见、使用最广泛的一种，拥有自己独立的上限以控制产量。它是制造工具的重要材料，也可用于建筑施工。";
		}
		{
			String _name = "column2text02";
			String _text = "5 份铁矿石 + ";
		}
		{
			String _name = "column2text03";
			String _text = "2 份焦炭或木炭";
		}
		{
			String _name = "Iron01Tip";
			String _text = "此方法每个周期的投入成本为 34-36（木炭-焦炭）。未受教育的工人使用焦炭会亏损 2 点，使用木炭则收支持平，且只能产出 1 份铁；而受过教育的工人则可获得 32-34（焦炭-木炭）点总利润，即每份铁 16-17 点。";
		}
		{
			String _name = "column2text04";
			String _text = "3 份铁矿石 + ";
		}
		{
			String _name = "column2text05";
			String _text = "1 份石灰 + ";
		}
		{
			String _name = "column2text06";
			String _text = "2 份焦炭或木炭";
		}
		{
			String _name = "Iron02Tip";
			String _text = "此方法每个周期的投入成本为 31-33（木炭-焦炭）。未受教育的工人可获得 1-3（焦炭-木炭）点利润，且只能产出 1 份铁；而受过教育的工人则可获得 35-37 点总利润，即每份铁 17.5-18.5 点。正如焦炭相对于木炭一样，石灰相较于铁矿石也可能是更廉价的生产材料，因此整体端到端的利润很可能更高。";
		}
		{
			String _name = "IronQty";
			String _text = "产出：1-2";
		}
		{
			String _name = "IronValue";
			String _text = "34";
		}
		{
			String _name = "IronWeight";
			String _text = "25";
		}
		{
			String _name = "column2text01c";
			String _text = "铜";
		}
		{
			String _name = "Copper00Tip";
			String _text = "铜的生产受“金属、合金与锻造品”上限的控制，主要用于建筑施工，但也可用于制造工具及其他铜制品。";
		}
		{
			String _name = "column2text02c";
			String _text = "5 份铜矿石 + ";
		}
		{
			String _name = "Copper01Tip";
			String _text = "此方法每个周期的投入成本为 34-36（木炭-焦炭）。未受教育的工人会亏损 4-6 点，且只能产出 1 份铜；而受过教育的工人则可获得 24-26（焦炭-木炭）点总利润，即每份铜 12-13 点。";
		}
		{
			String _name = "column2text04c";
			String _text = "3 份铜矿石 + ";
		}
		{
			String _name = "Copper02Tip";
			String _text = "此方法每个周期的投入成本为 31-33（木炭-焦炭）。未受教育的工人会亏损 1-3 点，且只能产出 1 份铜；而受过教育的工人则可获得 27-29（焦炭-木炭）点总利润，即每份铜 13.5-14.5 点。正如焦炭相对于木炭一样，石灰相较于铜矿石也可能是更廉价的生产材料，因此整体端到端的利润很可能更高。";
		}
		{
			String _name = "CopperQty";
			String _text = "产出：1-2";
		}
		{
