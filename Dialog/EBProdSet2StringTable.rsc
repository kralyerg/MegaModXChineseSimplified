		{ String _name = "EBApothecary";							String _text = "药房"; }
		{ String _name = "EBApothecaryLwr";							String _text = "药房"; }
		{ String _name = "EBApothecaryTip";							String _text = "药房用根茎、草药、葡萄酒、籽油、水和玻璃器皿制作保健物品。最多可雇佣2名药剂师生产3至4份疗养汤、疗养油或草药茶。建造周期：60。"; }
		
		{ String _name = "EBHerbalist";								String _text = "草药屋"; }
		{ String _name = "EBHerbalistLwr";							String _text = "草药屋"; }
		{ String _name = "EBHerbalistTip";							String _text = "草药屋用于采集草药，为居民提供简单的保健和治疗。最多可雇佣2名采药人采集2至3草药。建造周期：42。"; }
		
		{ String _name = "EBGlassWorks";							String _text = "玻璃作坊";	}
		{ String _name = "EBGlassWorksLwr";							String _text = "玻璃作坊";	}
		{ String _name = "EBGlassWorksTip";							String _text = "玻璃作坊用沙子和煤炭生产玻璃或玻璃器皿。最多可雇佣2名玻璃工匠，用23沙子+3煤炭或23沙子+4工业煤炭生产7至8玻璃或7至8玻璃器皿。建造周期：58。"; }
		
		{ String _name = "EBWinery";								String _text = "酿酒坊";	}
		{ String _name = "EBWineryLwr";								String _text = "酿酒坊";	}
		{ String _name = "EBWineryTip";								String _text = "酿酒坊用葡萄、李子或樱桃酿造葡萄酒。可雇佣1名酿酒师，用45樱桃、葡萄或李子生产7至10葡萄酒。建造周期：72。"; }
		
		{ String _name = "EBOilPress";								String _text = "榨油坊";	}
		{ String _name = "EBOilPressLwr";							String _text = "榨油坊";	}
		{ String _name = "EBOilPressTip";							String _text = "榨油坊用葵花籽榨取植物油，用山核桃或核桃榨取籽油，用亚麻榨取亚麻籽油。最多可雇佣2名榨油工人，用山核桃或核桃生产18至24籽油，用50葵花籽生产18至24植物油，用50亚麻生产18至24亚麻籽油。建造周期：64。"; }
		
		{ String _name = "EBShoreHut";								String _text = "海滩小屋";	}
		{ String _name = "EBShoreHutLwr";							String _text = "海滩小屋";	}
		{ String _name = "EBShoreHutTip";							String _text = "海滩小屋用于采集沙子或粘土。最多可雇佣2名工人，生产5至7沙子或8至10粘土。建造周期：38。"; }
		
		{ String _name = "CharcoalPile";							String _text = "炭窑"; }
		{ String _name = "CharcoalPileLwr";							String _text = "炭窑"; }
		{ String _name = "CharcoalPileTip";							String _text = "炭窑用木柴烧制工业煤炭。可雇佣1名工人，用4木柴生产4至5工业煤炭。建造周期：0。"; }
		
