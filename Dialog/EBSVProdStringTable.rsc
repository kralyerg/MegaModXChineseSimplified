		//buildings
		{ String _name = "EBSVTannery";									String _text = "村庄制革坊";	}
		{ String _name = "EBSVTanneryLwr";								String _text = "村庄制革坊";	}
		{ String _name = "EBSVTanneryTip";								String _text = "村庄制革坊生产鞣制皮革。可雇佣1名制革工人，用1皮革、1水和3盐生产1鞣制皮革。建造周期：50。2种F键颜色变体。";  }
		
		{ String _name = "EBSVSaltMine";								String _text = "村庄盐矿";	}
		{ String _name = "EBSVSaltMineLwr";								String _text = "村庄盐矿";	}
		{ String _name = "EBSVSaltMineTip";								String _text = "村庄盐矿从盐矿中提取盐。最多可雇佣2名工人来提取和加工盐。产量：8至12盐。建造周期：52。2种F键颜色变体。"; }
		
		{ String _name = "EBSVWaterWell";								String _text = "村庄水井";	}
		{ String _name = "EBSVWaterWellLwr";							String _text = "村庄水井";	}
		{ String _name = "EBSVWaterWellTip";							String _text = "村庄水井蕴含水源。可雇佣1名工人从井中汲取12至16水。建造周期：42。2种F键颜色变体。"; }
		
		{ String _name = "EBSVShoemaker";								String _text = "村庄鞋匠铺";	}
		{ String _name = "EBSVShoemakerLwr";							String _text = "村庄鞋匠铺";	}
		{ String _name = "EBSVShoemakerTip";							String _text = "村庄鞋匠铺生产鞋子。可雇佣1名鞋匠，用皮革、亚麻籽油和鞣制皮革制作多种鞋子。建造周期：50。2种F键颜色变体。";  }
		
		{ String _name = "EBSVOilPress";								String _text = "村庄榨油坊";	}
		{ String _name = "EBSVOilPressLwr";								String _text = "村庄榨油坊";	}
		{ String _name = "EBSVOilPressTip";								String _text = "村庄榨油坊用25葵花籽和1陶罐生产14至18植物油，用25山核桃或25核桃和1陶罐生产14至18籽油，或用25亚麻和1陶罐生产14至18亚麻籽油。最多可雇佣2名榨油工人，用山核桃或核桃生产18至24籽油，用50葵花籽生产18至24植物油，用50亚麻生产18至24亚麻籽油。建造周期：48。2种F键颜色变体。"; }
		
		{ String _name = "EBSVSandPit";									String _text = "村庄沙坑"; }
		{ String _name = "EBSVSandPitLwr";								String _text = "村庄沙坑"; }
		{ String _name = "EBSVSandPitTip";								String _text = "村庄沙坑生产沙子。最多可雇佣3名工人生产5至7沙子。建造周期：36。2种F键颜色变体。"; }
		
		{ String _name = "EBSVPottery";									String _text = "村庄陶艺坊";	}
		{ String _name = "EBSVPotteryLwr";								String _text = "村庄陶艺坊";	}
		{ String _name = "EBSVPotteryTip";								String _text = "村庄陶艺坊生产陶罐。可雇佣1名陶工，用4粘土和1煤炭或1木炭生产3至4陶罐。建造周期：50。2种F键颜色变体。";  }
		
		{ String _name = "EBSVKiln";									String _text = "村庄窑炉";	}
		{ String _name = "EBSVKilnLwr";									String _text = "村庄窑炉";	}
		{ String _name = "EBSVKilnTip";									String _text = "村庄窑炉生产砖块。可雇佣1名工人，用粘土和燃料生产砖块。建造周期：50。2种F键颜色变体。";  }
		
		{ String _name = "EBSVClayPit";									String _text = "村庄粘土坑"; }
		{ String _name = "EBSVClayPitLwr";								String _text = "村庄粘土坑"; }
		{ String _name = "EBSVClayPitTip";								String _text = "村庄粘土坑生产粘土。最多可雇佣3名工人生产5至7粘土。建造周期：36。2种F键颜色变体。"; }
		
		{ String _name = "EBSVApiary";									String _text = "村庄养蜂场"; }
		{ String _name = "EBSVApiaryLwr";								String _text = "村庄养蜂场"; }
		{ String _name = "EBSVApiaryTip";								String _text = "村庄养蜂场用于养蜂并产出蜂蜜。最多可雇佣2名养蜂人生产16至22蜂蜜。建造周期：46。2种F键颜色变体。"; }
		
		{ String _name = "EBSVPreservist";								String _text = "村庄腌制坊"; }
		{ String _name = "EBSVPreservistLwr";							String _text = "村庄腌制坊"; }
		{ String _name = "EBSVPreservistTip";							String _text = "村庄腌制坊生产瓶装肉或瓶装水果。最多可雇佣2名腌制工人，用7鹿肉、羊肉、牛肉或鸡肉、2盐和1陶罐生产12至14瓶装肉，或用7李子、梨或桃、2蜂蜜和1陶罐生产10至14瓶装水果。建造周期：52。2种F键颜色变体。"; }
		
