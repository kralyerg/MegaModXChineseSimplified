		{ String _name = "Forwardpost";				String _text = "前哨据点"; }
		{ String _name = "ForwardpostLwr";			String _text = "前哨据点"; }
		{ String _name = "ForwardpostTip";			String _text = "该据点代表您的军队深入敌方领地的一处据点。在这个时代，成功的战争需要枪械和绚丽的军服，但当您击败敌人后，该据点将为您的殖民地产出多种有用物资——包括各类利润丰厚的建筑材料、珍贵文物，或从战败者手中缴获的稀有贸易商品。"; }
		{ String _name = "ForwardpostBoxTip";			String _text = "需求：军需物资。产出：随机产出美酒、烈酒、火枪、大炮、陶器、宝石、兽皮外衣、原住民文物中的一种。"; }

		{ String _name = "MusketRange";				String _text = "火枪靶场"; }
		{ String _name = "MusketRangeLwr";			String _text = "火枪靶场"; }
		{ String _name = "MusketRangeTip";			String _text = "这里是您殖民地士兵训练成为最强、最有准备之人的地方，以应对这个世界的任何挑战。在必要的操练过程中，殖民地生存所必需的物资（例如工具和衣物）将被生产出来。"; }
		{ String _name = "MusketRangeBoxTip";			String _text = "需求：芬尼。产出：随机产出钢制工具、火枪、军服、麦芽酒、烟斗烟草中的一种。"; }

