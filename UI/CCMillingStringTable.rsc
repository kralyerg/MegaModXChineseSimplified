		{ String _name = "cc17Windmill";				String _text = "城市风车磨坊"; }
		{ String _name = "cc17WindmillLwr";				String _text = "城市风车磨坊"; }
		{ String _name = "cc17WindmillTip";				String _text = "城市风车磨坊是一座大型建筑，能够用多种谷物磨制面粉。它是现有效率最高、速度最快的风车磨坊。"; }

		{ String _name = "Watermill";					String _text = "水力磨坊"; }
		{ String _name = "WatermillLwr";				String _text = "水力磨坊"; }
		{ String _name = "WatermillTip";				String _text = "水力磨坊可用谷物磨制面粉，必须建造在岸边。面粉本身不可食用，可送往面包坊加工成食物，也可用于贸易。按 F 键切换外观。"; }

		{ String _name = "Windmill";					String _text = "大型风车磨坊"; }
