		{ String _name = "ProfessionMillerTip";			String _text = "磨坊工负责操作磨坊，将谷物磨碎制成面粉。"; }
		{ String _name = "ProfessionMillerDeath";		String _text = "在磨粉时被水车碾压致死。"; }

