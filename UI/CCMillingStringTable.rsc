		{ String _name = "StoneWindmill";				String _text = "小型风车磨坊"; }
		{ String _name = "StoneWindmillLwr";			String _text = "小型风车磨坊"; }
		{ String _name = "StoneWindmillTip";			String _text = "小型风车磨坊可用谷物磨制面粉。面粉本身不可食用，可送往面包坊加工成食物，也可用于贸易。这种风车磨坊制粉速度比大型风车磨坊慢。"; }


