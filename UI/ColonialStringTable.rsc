		{ String _name = "WaterTowerTip";				String _text = "水塔提供洁净水，可在酒馆厨房建筑中用于灌装锡制水壶——居民很喜欢这样。居民也可以直接饮用生水以维持生存，但这会对健康产生不良影响。"; }

	// ##########################################
	// ##    Resource production buildings    ##
	// ##########################################
		{ String _name = "SawmillBL";					String _text = "锯木厂"; }
		{ String _name = "SawmillBLLwr";				String _text = "锯木厂"; }
		{ String _name = "SawmillBLTip";				String _text = "生产木材或柴火，最多可容纳三名伐木工同时作业。工作速度过快会迅速耗尽可用原木。"; }
		
		{ String _name = "Sawmill";						String _text = "水车锯木厂"; }
		{ String _name = "SawmillLwr";					String _text = "水车锯木厂"; }
		{ String _name = "SawmillTip";					String _text = "一座由水车驱动的锯木厂。生产木材或柴火，最多可容纳三名伐木工同时作业。工作速度过快会迅速耗尽可用原木。"; }

		{ String _name = "Chopper";						String _text = "砍伐场"; }
		{ String _name = "ChopperLwr";					String _text = "砍伐场"; }
		{ String _name = "ChopperTip";					String _text = "一处规模较小、较为简陋的伐木场地。"; }
		
		{ String _name = "Workcamp";					String _text = "劳工营地"; }
		{ String _name = "WorkcampLwr";					String _text = "劳工营地"; }
		{ String _name = "WorkcampTip";					String _text = "军队并非只关乎战争——在和平时期，建设与开发土地一直是军事力量的职责之一。这座劳工营地将基本军饷、工具，以及闲不住的驻军精力，转化为基础资源。"; }
		{ String _name = "WorkcampBoxTip";				String _text = "需要：芬尼和铁制工具。产出：随机组合的铁、玻璃、煤炭、砖、陶器、原木。"; }

		{ String _name = "LargeSmithy";					String _text = "大型铁匠铺"; }
		{ String _name = "LargeSmithyLwr";				String _text = "大型铁匠铺"; }
		{ String _name = "LargeSmithyTip";				String _text = "大型铁匠铺是一座规模宏大的作坊，最多可容纳两名铁匠，配备了制作多种工具所需的场地和设备，还能额外生产火枪以保卫殖民地。"; }
		
		{ String _name = "RuralSmith";					String _text = "乡村铁匠铺"; }
		{ String _name = "RuralSmithLwr";				String _text = "乡村铁匠铺"; }
		{ String _name = "RuralSmithTip";				String _text = "乡村铁匠铺是一座规模宏大的作坊，最多可容纳两名铁匠，配备了制作多种工具所需的场地和设备，还能额外生产火枪以保卫殖民地。"; }

		{ String _name = "Clothier";					String _text = "成衣铺"; }
		{ String _name = "ClothierLwr";					String _text = "成衣铺"; }
		{ String _name = "ClothierTip";					String _text = "成衣铺是裁缝铺的升级版，制作品质更高、更保暖、贸易价值更高的衣物。"; }
		
		{ String _name = "Stitcher";					String _text = "军服制作坊"; }
		{ String _name = "StitcherLwr";					String _text = "军服制作坊"; }
		{ String _name = "StitcherTip";					String _text = "军服制作坊是专门生产华丽军服的军需专家。这些军服对提升士兵作战士气至关重要，也是你军事实力的重要组成部分。仅生产全套礼服。"; }
		
		{ String _name = "Quartermaster";				String _text = "军需官"; }
		{ String _name = "QuartermasterLwr";			String _text = "军需官"; }
		{ String _name = "QuartermasterTip";			String _text = "军需官是你在新地区建立军事据点时，必须建造的第一座、也是最重要的建筑。配置人员后，你的海军特工将持续不断地运来军用物资。"; }

		{ String _name = "Firebundler";					String _text = "柴捆棚"; }
		{ String _name = "FirebundlerLwr";				String _text = "柴捆棚"; }
		{ String _name = "FirebundlerTip";				String _text = "在柴捆棚，有机物被收集并切割成可用的柴捆，作为生火燃料"; }

		{ String _name = "Shorepit";					String _text = "滨岸小屋"; }
		{ String _name = "ShorepitLwr";					String _text = "滨岸小屋"; }
		{ String _name = "ShorepitTip";					String _text = "滨岸小屋是挖掘沙子和粘土的地方，可进一步送往玻璃作坊或砖窑加工，此处也能发现青蛙和乌龟。"; }
		
		{ String _name = "Chandlery";					String _text = "制烛坊"; }
		{ String _name = "ChandleryLwr";				String _text = "制烛坊"; }
		{ String _name = "ChandleryTip";				String _text = "制烛坊用于以蜂蜡、鲸脂或牛羊脂制作蜡烛。"; }

		{ String _name = "PearlStand";					String _text = "采珠人"; }
		{ String _name = "PearlStandLwr";				String _text = "采珠人"; }
		{ String _name = "PearlStandTip";				String _text = "只要提供足够的牡蛎，采珠人就有可能寻获珍稀珍珠。"; }

