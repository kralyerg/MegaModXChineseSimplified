		{ String _name = "Watermill";					String _text = "水磨坊"; }
		{ String _name = "WatermillLwr";				String _text = "水磨坊"; }
		{ String _name = "WatermillTip";				String _text = "水磨坊利用谷物磨制面粉，必须建在岸边。面粉不可直接食用，可送往面包坊加工成食物，也可用于贸易。按F键可切换外观。"; }
		
		{ String _name = "Watermill3";					String _text = "纤维水磨坊"; }
		{ String _name = "Watermill3Lwr";				String _text = "纤维水磨坊"; }
		{ String _name = "Watermill3Tip";				String _text = "纤维水磨坊是一种更快速地将纤维（如布料、亚麻布和丝绸）加工成产品的方式，必须建在岸边。"; }

		{ String _name = "Windmill";					String _text = "大型风车磨坊"; }
		{ String _name = "WindmillLwr";					String _text = "大型风车磨坊"; }
		{ String _name = "WindmillTip";					String _text = "大型风车磨坊利用谷物磨制面粉。面粉不可直接食用，可送往面包坊加工成食物，也可用于贸易。"; }

		{ String _name = "StoneWindmill";				String _text = "小型风车磨坊"; }
		{ String _name = "StoneWindmillLwr";			String _text = "小型风车磨坊"; }
		{ String _name = "StoneWindmillTip";			String _text = "小型风车磨坊利用谷物磨制面粉。面粉不可直接食用，可送往面包坊加工成食物，也可用于贸易。此风车磨坊制粉速度比大型风车磨坊慢。"; }

		{ String _name = "Oilpress";					String _text = "榨油坊"; }
		{ String _name = "OilpressLwr";					String _text = "榨油坊"; }
		{ String _name = "OilpressTip";					String _text = "榨油坊从橄榄，以及采收的葵花籽、亚麻籽、棉籽和鲸脂中提取油脂。灯油最好由鲸油压榨而成，但也可用其他有机原料制作，不过代价较高。"; }

		{ String _name = "Apiary";						String _text = "养蜂场"; }
		{ String _name = "ApiaryLwr";					String _text = "养蜂场"; }
		{ String _name = "ApiaryTip";					String _text = "养蜂场产出蜂蜜作为食物，或产出蜂蜡，可在制烛坊加工成蜡烛。"; }

		{ String _name = "Bakery";						String _text = "面包坊"; }
		{ String _name = "BakeryLwr";					String _text = "面包坊"; }
		{ String _name = "BakeryTip";					String _text = "面包坊生产多种不同营养价值的面包和蛋糕。"; }

		{ String _name = "Refinery";					String _text = "制糖坊"; }
		{ String _name = "RefineryLwr";					String _text = "制糖坊"; }
		{ String _name = "RefineryTip";					String _text = "制糖坊将甘蔗和甜菜加工成糖，将枫树汁加工成糖浆。你也可以将枫糖浆进一步精炼成糖，但效率很低，几乎需要双倍的原料。"; }

		{ String _name = "Wharfship";					String _text = "码头与渔船"; }
		{ String _name = "WharfshipLwr";				String _text = "码头与渔船"; }
		{ String _name = "WharfshipTip";				String _text = "配备渔船的码头是一座高级建筑，用于在远海捕捞鲸鱼、海豹和龙虾。鲸脂是在榨油坊制作灯油的必需原料，也是建造某些高级建筑的重要物资。"; }
		
		{ String _name = "Saltworks";					String _text = "制盐场"; }
		{ String _name = "SaltworksLwr";				String _text = "制盐场"; }
		{ String _name = "SaltworksTip";				String _text = "一座制盐场，利用风力水泵和大型煮盐锅从海水中提炼食盐。"; }

		{ String _name = "Creamery";					String _text = "老式奶场"; }
		{ String _name = "CreameryLwr";					String _text = "老式奶场"; }
		{ String _name = "CreameryTip";					String _text = "老式奶场利用牛奶制作黄油、奶油和奶酪。只要有牛奶供应，这三种产品都会由乳品工自动制作。"; }

		{ String _name = "CowBarn";					String _text = "挤奶棚"; }
		{ String _name = "CowBarnLwr";					String _text = "挤奶棚"; }
		{ String _name = "CowBarnTip";					String _text = "挤奶棚产出牛奶。建造它需要一定数量的驯养动物资源。"; }

		{ String _name = "CowParlour";					String _text = "乳品作坊"; }
		{ String _name = "CowParlourLwr";				String _text = "乳品作坊"; }
		{ String _name = "CowParlourTip";				String _text = "乳品作坊利用牛奶制作黄油、奶油和奶酪。只要有牛奶供应，这三种产品都会由乳品工自动制作。"; }

		{ String _name = "Preservists";					String _text = "蜜饯坊"; }
		{ String _name = "PreservistsLwr";				String _text = "蜜饯坊"; }
		{ String _name = "PreservistsTip";				String _text = "利用水果和蔬菜制作果酱、腌菜等蜜饯。果酱需要制糖坊提供的糖，腌菜需要酿酒坊提供的烈酒。玻璃器皿则来自玻璃作坊。"; }

