		{ String _name = "LlamaEasyName";		String _text = "[CC] 金羊驼的诅咒 - 简单"; }
		{ String _name = "LlamaEasyDesc";		String _text = "金羊驼的诅咒是班尼希德世界中最接近谜团的存在。金羊驼究竟是什么？它藏有怎样的秘密？您敢探索它幽暗的内部吗？本开局按常规简单难度设置开始，并附带前往探险以搏取宝藏机会的选项。"; }

		{ String _name = "LlamaMediumName";		String _text = "[CC] 金羊驼的诅咒 - 中等"; }
		{ String _name = "LlamaMediumDesc";		String _text = "金羊驼的诅咒是班尼希德世界中最接近谜团的存在。金羊驼究竟是什么？它藏有怎样的秘密？您敢探索它幽暗的内部吗？本开局按常规中等难度设置开始，并附带前往探险以搏取宝藏机会的选项。"; }

		{ String _name = "LlamaHardName";		String _text = "[CC] 金羊驼的诅咒 - 困难"; }
		{ String _name = "LlamaHardDesc";		String _text = "金羊驼的诅咒是班尼希德世界中最接近谜团的存在。金羊驼究竟是什么？它藏有怎样的秘密？您敢探索它幽暗的内部吗？本开局按常规困难难度设置开始，并附带前往探险以搏取宝藏机会的选项。"; }

		{ String _name = "LlamaAEName";			String _text = "[CC] 金羊驼的诅咒 - 亚当与夏娃"; }
		{ String _name = "LlamaAEDesc";			String _text = "金羊驼的诅咒是班尼希德世界中最接近谜团的存在。金羊驼究竟是什么？它藏有怎样的秘密？您敢探索它幽暗的内部吗？本开局按亚当与夏娃难度设置开始，并附带前往探险以搏取宝藏机会的选项。"; }

