		{ String _name = "ccSign1";						String _text = "任务告示牌"; }
		{ String _name = "ccSign1Lwr";					String _text = "任务告示牌"; }
		{ String _name = "ccSign11Tip";					String _text = "提供信息。"; }
		{ String _name = "QuoteSign1";					String _text = "任务：金羊驼的诅咒。欢迎来到《殖民地宪章》的“金羊驼的诅咒”任务。此告示牌可被拆除，但无法重建。数百年前，曾生活在此地的古老文明，因旧大陆疾病、战争与饥荒的共同肆虐而覆灭。贪婪的探险者们蜂拥而至，却一个接一个消失在茂密的丛林中，杳无音讯，再无音信。而那些侥幸归来之人，则从此过上了大富大贵的生活。如今，你来到此地却是为了一个截然不同的理由：生存。你会像那些勇敢（或许也愚蠢）的亡魂一样，屈服于同样的命运吗？还是会以鲜血向远古神祇换取财富？"; }
		{ String _name = "QuoteSign2";					String _text = "任务：是时候迈向新的边疆了——那片未经勘测、充满未知的西部，栖息着奇异的动物，生活着先进的美洲原住民部落，也蕴藏着无数冒险。你将拥有可供支配的新资源，也将面对全新的挑战——你能否与当地部落结为盟友？又或者，你那初生的前哨据点，能否护佑你的居民，抵御这世界边缘严酷生活的考验？"; }
		
		{ String _name = "Outhouse";					String _text = "茅厕"; }
