		{ String _name = "BayouEasyName";		String _text = "[CC] 河湾沼泽 - 简单"; }
		{ String _name = "BayouEasyDesc";		String _text = "河湾沼泽提供了建立码头小镇所需的一切。附带一些稻米、工具、衣物和柴火，附近还有鸡群。"; }

