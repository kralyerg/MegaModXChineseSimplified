		{ String _name = "FantasyEasyName";		String _text = "[CC] 野趣天地 - 简单"; }
		{ String _name = "FantasyEasyDesc";		String _text = "这片土地上遍布各种天然食物资源，可随时在野外采集。石料与铁矿也会重新生成。由于野外持续不断地生长着大量不自然的资源，本地图极为简单且不太真实。除此之外，这是一局典型的简单开局。"; }

		{ String _name = "FantasyAEName";		String _text = "[CC] 野趣天地 - 亚当与夏娃"; }
