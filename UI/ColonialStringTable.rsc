		{ String _name = "AppalachianMediumDesc";		String _text = "一局标准中等开局，包含模组与游戏中除热带树木外的所有树木。中等开局以5个家庭开始。提供衣物、食物、柴火、工具和建筑材料。已建成一座储物仓。附带部分农田和果园种子。"; }

