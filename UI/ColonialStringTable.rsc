		{ String _name = "CCStatue1";					String _text = "石质特许雕像"; }
		{ String _name = "CCStatue1Lwr";				String _text = "石质特许雕像"; }
		{ String _name = "CCStatue1Tip";				String _text = "一座描绘殖民地总督的雕像。"; }
		{ String _name = "Quote1";						String _text = "或许你人生的意义，只是给他人提个警示。"; }

		{ String _name = "CCStatue2";					String _text = "石质特许雕像"; }
		{ String _name = "CCStatue2Lwr";				String _text = "石质特许雕像"; }
		{ String _name = "CCStatue2Tip";				String _text = "一座描绘殖民地总督骑乘羊驼的雕像。"; }
		{ String _name = "Quote2";						String _text = "这座殖民地最阴暗的秘密是，仍有太多居民幻想着自己本该属于别处一个更高等的文明。"; }
		
		{ String _name = "CCStatue3";					String _text = "木质马雕像"; }
		{ String _name = "CCStatue3Lwr";				String _text = "木质马雕像"; }
		{ String _name = "CCStatue3Tip";				String _text = "一座扬蹄嘶鸣的骏马雕像。"; }
		{ String _name = "Quote3";						String _text = "那当然是匹马！"; }
		
		{ String _name = "CCStatueJade1";				String _text = "玉石雕像"; }
		{ String _name = "CCStatueJade1Lwr";			String _text = "玉石雕像"; }
		{ String _name = "CCStatueJade1Tip";			String _text = "一座融合了远方异域风格雕刻而成的雕像。"; }
		{ String _name = "QuoteJade1";					String _text = "道不在天上，道在心中。——乔达摩·佛陀"; }
		
		{ String _name = "CCStatueMarble1";				String _text = "大理石雕像"; }
		{ String _name = "CCStatueMarble1Lwr";			String _text = "大理石雕像"; }
		{ String _name = "CCStatueMarble1Tip";			String _text = "一座融合了远方异域风格雕刻而成的雕像。按F键可切换外观。"; }
		{ String _name = "QuoteMarble1";				String _text = "我在大理石中看见了天使，于是不断雕刻，直至将他释放。——米开朗基罗"; }
		
		{ String _name = "CCStatueIron1";				String _text = "铁雕像"; }
		{ String _name = "CCStatueIron1Lwr";			String _text = "铁雕像"; }
		{ String _name = "CCStatueIron1Tip";			String _text = "一座法院钟雕像，象征着为定居点居民伸张正义。"; }
		{ String _name = "QuoteIron1";					String _text = "因为我们必须谨记，我们将如山巅之城。世人的目光都在注视着我们。——约翰·温思罗普"; }
		
		{ String _name = "LionStatue";					String _text = "青铜雕像"; }
