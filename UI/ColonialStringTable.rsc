		{ String _name = "Forwardpost";					String _text = "前哨站"; }
		{ String _name = "ForwardpostLwr";				String _text = "前哨站"; }
		{ String _name = "ForwardpostTip";				String _text = "这座哨站代表着你的军事力量深入敌方领土的一次远征。这个时代要打胜仗需要枪支和华丽多彩的军服，但当你击败敌人后，哨站将为你的殖民地产出许多有用的物资——包括各种利润丰厚的建筑物资、珍贵的文物，或从战败者那里缴获的稀有贸易货物。"; }
		{ String _name = "ForwardpostBoxTip";			String _text = "需要：火枪、全套礼服和军用物资。产出：随机组合的金盾、船体构件、家居用品、精美家具、建筑物资、托梁、玉石、大理石、丝绸、灯油、大理石雕像、玉石雕像、石雕像、木雕像、原住民文物。"; }

		{ String _name = "MusketRange";					String _text = "火枪靶场"; }
		{ String _name = "MusketRangeLwr";				String _text = "火枪靶场"; }
		{ String _name = "MusketRangeTip";				String _text = "这里是殖民地士兵训练的地方，让他们做好万全准备，以应对这个世界抛来的任何挑战。在必要的操练过程中，将会产出对殖民地生存至关重要的物资（如工具、衣物和燃料）。"; }
		{ String _name = "MusketRangeBoxTip";			String _text = "需要：芬尼和硬饼干。产出：随机组合的钢制工具、柴火、呢大衣、炉用燃料、木炭。"; }

