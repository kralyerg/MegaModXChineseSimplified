	//STARTING CONDITIONS
		{ String _name = "CCcustom1Name";		String _text = "殖民地宪章"; }
		{ String _name = "CCcustom1Desc";		String _text = "此处填写殖民地宪章的描述"; }

		{ String _name = "CCAdamEve";			String _text = "[CC] 亚当与夏娃"; }
		{ String _name = "CCAdamEveDesc";		String _text = "仅有2人开局。一辆小型储物车中提供少量食物、柴火和衣物。尚未建造任何建筑，初始时也没有种子或牲畜——您必须自力更生获取一切。"; }

		{ String _name = "CCSilkRoad";			String _text = "[CC] 丝绸之路 - 简单"; }
		{ String _name = "CCSilkRoadDesc";		String _text = "初始便具备饲养蚕并采收珍贵蚕丝的能力。开局以6个家庭开始。提供大量衣物、食物、柴火、建筑材料和工具。已建成住宅与仓储区域。"; }
		
		{ String _name = "CCSilkRoadMed";		String _text = "[CC] 丝绸之路 - 中等"; }
		{ String _name = "CCSilkRoadMedDesc";		String _text = "初始便具备饲养蚕并采收珍贵蚕丝的能力。开局以5个家庭开始。提供衣物、食物、柴火、工具和建筑材料。已建成一座储物仓。"; }

		{ String _name = "CCSilkRoadHard";		String _text = "[CC] 丝绸之路 - 困难"; }
		{ String _name = "CCSilkRoadHardDesc";		String _text = "初始便具备饲养蚕并采收珍贵蚕丝的能力。困难开局以4个家庭开始。提供少量衣物、食物、柴火和工具。白桑种子是唯一可用的种子。"; }
		
		{ String _name = "CCMine";			String _text = "[CC] 矿井"; }

		{ String _name = "CCMineDesc";			String _text = "特殊采矿，可获得珍贵物品。"; }

		{ String _name = "CCMediumPlus";		String _text = "[CC] 中等+"; }
		{ String _name = "CCMediumPlusDesc";		String _text = "加入牲畜。中等+开局以5个家庭开始。提供衣物、食物、柴火、工具和建筑材料。已建成一座储物仓。附带部分农田和果园种子，以及一群牲畜。"; }
		
		{ String _name = "CCMissionary";		String _text = "[CC] 传教士"; }
		{ String _name = "CCMissionaryDesc";		String _text = "传教士开局以一座教区宅邸和三个家庭开始，其中2户未受教育。已建成2座住宅并提供部分基础物资，附带一辆储物车。同时提供部分农田和果园种子，以及一群牲畜。"; }
		
		{ String _name = "CCFort";			String _text = "[CC] 新边疆"; }
		{ String _name = "CCFortDesc";		String _text = "新边疆让您在一座友好的美洲原住民村落旁的边境哨所开局。守护并壮大您的子民，您的传奇将在西部世代流传。本开局以3个家庭开始，已建成一座配有部分物资的小型堡垒。还可在祭祀场探寻宝藏。"; }

		{ String _name = "CCFortHard";			String _text = "[CC] 原住民村落 - 困难"; }
		{ String _name = "CCFortHardDesc";		String _text = "原住民村落开局要求您与当地原住民部落保持良好关系，属于较为困难的开局方式。村落需要资源（升级）来表明您的友好意愿，之后您可以选择与这些建筑互动的方式。作为这片土地上的外来者，寻求盟友而非树敌将让您受益良多。"; }

		{ String _name = "CCFortAE";			String _text = "[CC] 原住民村落 - 亚当与夏娃"; }
		{ String _name = "CCFortAEDesc";		String _text = "仅有2人开局。一辆小型储物车中提供少量食物、柴火和衣物。原住民村落开局要求您与当地原住民部落保持良好关系，属于较为困难的开局方式。村落需要资源（升级）来表明您的友好意愿，之后您可以选择与这些建筑互动的方式。作为这片土地上的外来者，寻求盟友而非树敌将让您受益良多。"; }

		{ String _name = "PalmsOnlyEasyName";		String _text = "[CC] 安的列斯 - 简单"; }
		{ String _name = "PalmsOnlyEasyDesc";		String _text = "一局标准简单开局，仅有棕榈树和热带树木。简单开局以6个家庭开始。提供大量衣物、食物、柴火、建筑材料和工具。已建成住宅与仓储区域。附带农田和果园种子，以及一群牲畜。"; }

		{ String _name = "PalmsOnlyMediumName";		String _text = "[CC] 安的列斯 - 中等"; }
		{ String _name = "PalmsOnlyMediumDesc";		String _text = "一局标准中等开局，仅有棕榈树和热带树木。中等开局以5个家庭开始。提供衣物、食物、柴火、工具和建筑材料。已建成一座储物仓。附带部分农田和果园种子。"; }

		{ String _name = "PalmsOnlyHardName";		String _text = "[CC] 安的列斯 - 困难"; }
		{ String _name = "PalmsOnlyHardDesc";		String _text = "一局标准困难开局，仅有棕榈树和热带树木。困难开局以4个家庭开始。提供少量衣物、食物、柴火和工具。没有可用于耕种的种子。"; }
		
		{ String _name = "PalmsOnlyHardFewName";		String _text = "[CC] 安的列斯（稀疏） - 困难"; }
		{ String _name = "PalmsOnlyHardFewDesc";		String _text = "一局标准困难开局，仅有稀疏的棕榈树和热带树木，地表石料与矿石也很稀少。困难开局以4个家庭开始。提供少量衣物、食物、柴火和工具。没有可用于耕种的种子。"; }

		{ String _name = "PalmsOnlyAEName";		String _text = "[CC] 安的列斯 - 亚当与夏娃"; }
