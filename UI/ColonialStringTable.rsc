		{ String _name = "AppalachianHardDesc";		String _text = "一局标准困难开局，包含模组与游戏中除热带树木外的所有树木。困难开局以4个家庭开始。提供少量衣物、食物、柴火和工具。没有可用于耕种的种子。"; }

		{ String _name = "AppalachianAEName";		String _text = "[CC] 阿巴拉契亚森林 - 亚当与夏娃"; }
		{ String _name = "AppalachianAEDesc";		String _text = "一局标准亚当与夏娃开局，包含模组与游戏中除热带树木外的所有树木。一辆小型储物车中提供少量食物、柴火和衣物。尚未建造任何建筑，初始时也没有种子或牲畜——您必须自力更生获取一切。"; }

		{ String _name = "NewTrees2LiteEasyName";	String _text = "[CC] 新树林（精简版） - 简单"; }
		{ String _name = "NewTrees2LiteEasyDesc";	String _text = "为性能优化的精简版本。一局标准简单开局，仅有模组新增树木（不含棕榈树）。简单开局以6个家庭开始。提供大量衣物、食物、柴火、建筑材料和工具。已建成住宅与仓储区域。附带农田和果园种子，以及一群牲畜。"; }

		{ String _name = "NewTrees2LiteMediumName";	String _text = "[CC] 新树林（精简版） - 中等"; }
		{ String _name = "NewTrees2LiteMediumDesc";	String _text = "为性能优化的精简版本。一局标准中等开局，仅有模组新增树木（不含棕榈树）。中等开局以5个家庭开始。提供衣物、食物、柴火、工具和建筑材料。已建成一座储物仓。附带部分农田和果园种子。"; }

