		{ String _name = "Silkwormhut";					String _text = "蚕舍"; }
		{ String _name = "SilkwormhutLwr";				String _text = "蚕舍"; }
		{ String _name = "SilkwormhutTip";				String _text = "蚕舍饲养蚕来制作丝绸，在万不得已时也可作为食物。蚕需要以白桑叶为食，这些桑叶可通过贸易获得，也可来自果园。"; }

