		{ String _name = "CCcustom1Name";					String _text = "殖民地宪章"; }
		{ String _name = "CCcustom1Desc";					String _text = "殖民地宪章说明文字置于此处"; }

		{ String _name = "CCAdamEve";						String _text = "[CC] 亚当与夏娃"; }
		{ String _name = "CCAdamEveDesc";					String _text = "仅以2人开局。一辆小型储藏推车中提供少量食物、柴火和衣物。尚未建造任何建筑，初始也没有工具、种子或牲畜——你必须自行生存并获取一切所需。"; }

		{ String _name = "CCSilkRoad";						String _text = "[CC] 丝绸之路 - 简单"; }
		{ String _name = "CCSilkRoadDesc";					String _text = "开局便具备饲养和采收蚕以获取珍贵丝绸的能力。以六户家庭开局，提供大量衣物、食物、柴火、建筑材料和工具，且住宅与储藏区都已建好。"; }
		
		{ String _name = "CCSilkRoadMed";					String _text = "[CC] 丝绸之路 - 中等"; }
		{ String _name = "CCSilkRoadMedDesc";					String _text = "开局便具备饲养和采收蚕以获取珍贵丝绸的能力。以五户家庭开局，提供衣物、食物、柴火、工具和建筑材料，并已建好一座储藏谷仓。"; }
		
		{ String _name = "CCMine";							String _text = "[CC] 矿场"; }
		{ String _name = "CCMineDesc";						String _text = "开采珍稀物品的特殊矿场。"; }

		{ String _name = "CCMediumPlus";					String _text = "[CC] 中级+"; }
		{ String _name = "CCMediumPlusDesc";					String _text = "新增牲畜。中级以上难度的游戏以五户家庭开局，提供衣物、食物、柴火、工具和建筑材料，并已建好一座储藏谷仓。还提供了一些田地和果园用的种子，以及一群牲畜。"; }
		
		{ String _name = "CCMissionary";					String _text = "[CC] 传教士"; }
		{ String _name = "CCMissionaryDesc";					String _text = "传教士模式的游戏以一座教区之家和三户家庭开局，其中2户尚未受教育。已建好2座房屋并提供一些基础物资，另有一辆储藏推车可用。还提供了一些田地和果园用的种子，以及一群牲畜。"; }

