		{ String _name = "TradeWarehouse";					String _text = "资源仓库"; }
		{ String _name = "TradeWarehouseLwr";				String _text = "资源仓库"; }
		{ String _name = "TradeWarehouseTip";				String _text = "可调节储量的仓库，用于储存你现有的各类产品和资源。你必须拥有至少1单位某类产品，其储藏按钮才会出现。存放在此建筑中的物品，只有在你手动减少数量时才会释放到城镇中。若无你的干预，这些储存物品不会自由供人取用。"; }

		{ String _name = "LargeSmithy";						String _text = "大型锻造坊"; }
		{ String _name = "LargeSmithyLwr";					String _text = "大型锻造坊"; }
		{ String _name = "LargeSmithyTip";					String _text = "大型锻造坊能制作包括钢制工具和大梁在内的高级产品，这些是建造某些高级建筑所需的材料。"; }

		{ String _name = "KilnBuilding";					String _text = "堆烧工"; }
		{ String _name = "KilnBuildingLwr";					String _text = "堆烧工"; }
		{ String _name = "KilnBuildingTip";					String _text = "将木材或煤炭层层堆叠成堆，由内而外燃烧转化为燃料。是用于取暖或作业的优质轻型燃料来源。"; }
		
		{ String _name = "BrickBuilding";					String _text = "制砖坊"; }
		{ String _name = "BrickBuildingLwr";				String _text = "制砖坊"; }
		{ String _name = "BrickBuildingTip";				String _text = "制砖坊利用熔炉高温烧制成型砖块，这是建造某些高级建筑和砖石道路所需的材料。"; }
		
		{ String _name = "Abbey";							String _text = "修道院"; }
		{ String _name = "AbbeyLwr";						String _text = "修道院"; }
		{ String _name = "AbbeyTip";						String _text = "修道院内居住着采集浆果和草药、并酿造麦芽酒的僧侣。这些僧侣足智多谋，仅用当地食材便能制作产品，无需外部协助或物资配送。"; }

		{ String _name = "Ropery";							String _text = "制绳坊"; }
		{ String _name = "RoperyLwr";						String _text = "制绳坊"; }
		{ String _name = "RoperyTip";						String _text = "制绳坊是将大麻和亚麻捆绑制成绳索的场所。用大麻制绳所需的原材料略少于亚麻。"; }
		
		{ String _name = "Tinyshack";						String _text = "简陋小屋"; }
		{ String _name = "TinyshackLwr";					String _text = "简陋小屋"; }
		{ String _name = "TinyshackTip";					String _text = "一处小型简易住所，只能让新家庭发展至最多3人。但若是重新安置，任何规模的现有家庭都可以迁入。"; }
		
		{ String _name = "Tinyhouse";						String _text = "微型住宅"; }
		{ String _name = "TinyhouseLwr";					String _text = "微型住宅"; }
		{ String _name = "TinyhouseTip";					String _text = "一处小型简易住所，只能让新家庭发展至最多4人。但若是重新安置，任何规模的现有家庭都可以迁入。比简陋小屋更为保暖舒适。"; }
		
