		{ String _name = "DSCoalBellPit1Tip";			String _text = "一座原始煤矿，建于平地之上，需要3-8名矿工从地面的“钟”形矿坑中开采煤炭。产量有限（600），耗尽后将变为废弃矿坑。建造需消耗34工时。"; }

			{ String _name = "DSCoalBellPit1Upgrade";			String _text = "钟形煤坑矿场"; }

			{ String _name = "DSCoalBellPit1UpgradeLwr";		String _text = "钟形煤坑矿场"; }

			{ String _name = "DSCoalBellPit1UpgradeTip";		String _text = "升级后可延长使用寿命（5,400），并通过增设滑轮系统略微提高煤炭开采速度（最多13名矿工）。升级需消耗89工时。"; }

		

	

