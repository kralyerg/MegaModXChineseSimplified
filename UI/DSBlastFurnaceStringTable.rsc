		{ String _name = "DSThaddSurrelMineTip";		String _text = "Thadd Surrel家族的工业矿场，可开采煤炭或铁矿石。雇佣1-55名矿工。矿场整个生命周期内产能高达84,000。建造需消耗165工时。"; }

		

	

	

