		{
			String _name = "DSBloomerySmelterBronze3Tip";
			String _text = "一座原始的3x3块炼炉，用于将21铜矿石、3锡矿石、6木炭与13粘土加工成约9青铜。由于高温炙烤，这是从炉中取出青铜的唯一方式，完成后该炉将被摧毁并移除。如需继续生产，需要建造新的炉子。";
		}
