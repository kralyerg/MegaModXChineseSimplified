StringTable UI
{
	Entry _strings
	[
		{
			String _name = "text1";
			String _text = "块炼炉的冶炼由村里的劳工启动，他们会先清理该区域的一切，然后将矿石、木炭与粘土运送到现场。";
		}
		{
			String _name = "text2";
			String _text = "之后，建筑工会用粘土建造块炼炉。他们会将矿石与木炭交替分层加入炉中。在加入各层的早期阶段，炉子就会被点燃，建筑工会承担大部分工作，并戳出一个孔让不需要的炉渣排出，完成后便开始拆除。";
		}
		{
			String _name = "text3";
			String _text = "完成后，铁匠会取出铁块";
		}
		{
			String _name = "text4";
			String _text = "并对其进行加工，制成成品。";
		}
		{
			String _name = "text5";
			String _text = "一旦铁匠完成铁的加工，块炼炉就需要被拆除。";
		}
		{
			String _name = "text5copper";
			String _text = "一旦铁匠完成铜的加工，块炼炉就需要被拆除。";
		}
		{
			String _name = "IronRequire";
			String _text = "铁——最常见、使用最广泛的金属；铁有自己的产量上限用于控制生产。它是制造工具的重要材料，也用于建筑施工。";
		}
		{
			String _name = "CopperRequire";
			String _text = "铜——在'金属、合金与锻造制品'这一类上限下生产，以控制产量。主要用于建筑施工，但也可用于制作工具与铜器。";
		}
		{
			String _name = "BronzeRequire";
			String _text = "青铜——在'金属、合金与锻造制品'这一类上限下生产，以控制产量。作为早期产品用于制作工具，也用于建筑施工。";
		}
		{
			String _name = "CharcoalDestroy";
			String _text = "点击以拆除并开始清理现场。";
		}
		{
			String _name = "DestroyRemove";
			String _text = "块炼炉已失效；清理现场的工作已经开始。完成后你就可以移除炉子的旧地基。";
		}
		{
			String _name = "DestroyReclaimTip";
			String _text = "停止回收资源，并停止拆除该块炼炉。";
		}
		{
			String _name = "DestroyButton";
			String _text = "移除";
		}
		{
			String _name = "DestroyButtonTip";
			String _text = "既然你终于准备好移除并清理块炼炉了：";
		}
		{
			String _name = "text6";
			String _text = "哎呀！建筑工把废弃块炼炉的地基留下了，点击按钮将其移除。";
		}
	]

}
