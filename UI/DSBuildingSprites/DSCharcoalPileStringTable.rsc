StringTable UI
{
	Entry _strings
	[
		{
			String _name = "text1";
			String _text = "烧炭由村里的劳工启动；他们会先清理该区域的一切，然后将原木运送到现场。";
		}
		{
			String _name = "text2";
			String _text = "之后，建筑工会准备并将原木堆成一大堆木材，用一些泥土将其整个覆盖，在完全封闭之前，他们会点燃这堆木材。";
		}
		{
			String _name = "text3";
			String _text = "炭化过程完成后，烧炭工";
		}
		{
			String _name = "text4";
			String _text = "会确保炭堆熄灭，并取出木炭。";
		}
		{
			String _name = "text5";
			String _text = "木炭堆具有危险性，气味难闻且烟雾大。它们最适合建在村庄之外、森林之中，或远离其他建筑的地方。";
		}
		{
			String _name = "CharcoalRequire";
			String _text = "木炭——冶金燃料，但也用于一些住宅。用于锻造时，它能以熔化固态金属所需的极高温度燃烧。";
		}
		{
			String _name = "CharcoalDestroy";
			String _text = "点击以拆除并开始清理现场。";
		}
		{
			String _name = "DestroyRemove";
			String _text = "木炭堆已失效；清理现场的工作已经开始。完成后你就可以移除剩余的废弃灰烬。";
		}
		{
			String _name = "DestroyReclaimTip";
			String _text = "停止回收资源，并停止拆除该木炭堆。";
		}
		{
			String _name = "DestroyButton";
			String _text = "移除";
		}
		{
			String _name = "DestroyButtonTip";
			String _text = "既然你终于准备好移除并清理木炭堆了：";
		}
		{
			String _name = "text6";
			String _text = "哎呀！建筑工把木炭堆烧剩的灰烬留下了，点击按钮将其移除。";
		}
	]

}
