		{ String _name = "DSGlobeTheatreTip";		String _text = "以莎士比亚环球剧院为原型建造。雇佣表演者在剧院工作，他们将为居民带来快乐并赚取少量银币。建造需消耗610工时。每座城镇只能建造一座环球剧院。"; }
		
		
