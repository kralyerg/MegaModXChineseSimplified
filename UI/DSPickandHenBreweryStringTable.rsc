		{ String _name = "DSPickAndHenExt1Tip";			String _text = "扩大你的酿酒产能。建造一座右侧扩建部分。雇佣1名酿酒师，酿造麦芽酒、蜂蜜酒与果酒。每座城镇最多可建造2座。"; }

