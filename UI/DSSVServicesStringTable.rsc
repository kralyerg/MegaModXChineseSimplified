		{ String _name = "DSSVHerbalistTip";		String _text = "村庄草药师在维持居民健康方面发挥着重要作用。他们会采集草药，并为居民提供简单的保健与治疗服务。可雇佣 1-2 名草药师。需要 34 点工作量建造。"; }	

		

		{ String _name = "DSSVHospital";			String _text = "村庄医院"; }

		{ String _name = "DSSVHospitalLwr";			String _text = "村庄医院"; }

		{ String _name = "DSSVHospitalTip";			String _text = "村庄医院为生病的居民提供就诊场所，由医生进行治疗。建造后可获得基础医院，建成后可通过建筑信息面板上的按钮进行升级。需要 144 点工作量。"; }

		{ String _name = "HospitalUpgrade1Tip";			String _text = "升级村庄医院，可容纳 45 名病患，雇佣 1-2 名医生，新增一处偏楼，外部配有石墙及小型花园改造。需要 55 点工作量。"; }

				

		

		{ String _name = "DSSVVillageHall";				String _text = "村庄大厅"; }

		{ String _name = "DSSVVillageHallLwr";			String _text = "村庄大厅"; }

		{ String _name = "DSSVVillageHallTip";			String _text = "村庄大厅可以提升居民的幸福感，同时为玩家记录并显示村庄数据。每张地图最多可建造 3 座村庄大厅。"; }

		

		{ String _name = "DSSVSchool";					String _text = "小型村庄学校"; }

		{ String _name = "DSSVSchoolLwr";				String _text = "小型村庄学校"; }

		{ String _name = "DSSVSchoolTip";				String _text = "小型村庄学校。可为 20 名学生提供教育，雇佣 1 名教师。需要 55 点工作量建造。"; }

		

		{ String _name = "DSSVChapel";					String _text = "村庄小礼拜堂"; }

		{ String _name = "DSSVChapelLwr";				String _text = "村庄小礼拜堂"; }

		{ String _name = "DSSVChapelTip";				String _text = "村庄小礼拜堂。可容纳 50 名居民。需要 89 点工作量建造。"; }

		

		{ String _name = "DSSVChurch";					String _text = "村庄教堂"; }

