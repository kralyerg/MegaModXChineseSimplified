StringTable terrainType
{
	Entry _strings
	[
	{ String _name = "Valleys";	String _text = "山谷"; }
	{ String _name = "Mountains";	String _text = "山地"; }
	{ String _name = "DSSVLake";	String _text = "湖泊[DSSV]"; }
	{ String _name = "DSSVPlains";	String _text = "带湖泊的平原[DSSV]"; }
	{ String _name = "DSSVPlainsNoLakes";	String _text = "无湖泊的平原[DSSV]"; }
	{ String _name = "DSSVMountainLakes";	String _text = "山地湖泊[DSSV]"; }
	{ String _name = "DSSVTerrainDesc";	String _text = "[DSSV] = DS小村庄 v2 - 新开局条件与新地形类型说明：
																	湖泊 - 中央有一片大湖，周边有少量可用土地。
																	带湖泊的平原 - 一张平坦的“平原”类型地图，有一条河流，还有一个较小的湖泊。
																	无湖泊的平原 - 与上面类似 - 一张平坦的平原地图，但这次没有湖泊。
																	山地湖泊 - 一张艰难、几乎不适宜居住的地图，大片山脉
																	主导着地貌，还有深邃的“湖沼”式湖泊。"; }
	]
}

