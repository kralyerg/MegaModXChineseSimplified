		{ String _name = "DSSVEasyAnimalsName";		String _text = "简单-牧民 [DSSV]"; }

		{ String _name = "DSSVEasyAnimalsDesc";		String _text = "简单难度的游戏，附带大部分家畜。以六个家庭开局。1600 食物、30 衣物、30 工具、220 柴火、

																	120 木材、50 石料、30 铁。已建好一座 DSSV 储物谷仓。未建造住宅。没有种子。"; }

		

		{ String _name = "DSSVEasyName";		String _text = "简单 [DSSV]"; }

		{ String _name = "DSSVEasyDesc";		String _text = "简单难度的游戏以六个家庭开局。2400 食物、50 工具、50 衣物、400 柴火、

																150 木材、70 石料、50 铁。DSSV 住宅和储藏区域已经建好。

																最多提供 2 种作物种子和 2 种果园种子，以及 1 群家畜。"; }

																

		{ String _name = "DSSVMediumName";		String _text = "中等 [DSSV]"; }

		{ String _name = "DSSVMediumDesc";		String _text = "中等难度的游戏以五个家庭开局。1600 食物、30 衣物、30 工具、220 柴火、

																120 木材、50 石料、30 铁。已建好一座 DSSV 储物谷仓。

																最多提供 2 种作物种子和 1 种果园种子。没有家畜。"; }

																

