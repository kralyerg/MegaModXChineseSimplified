		{ String _name = "MediumName";			String _text = "中等"; }

		{ String _name = "MediumDesc";			String _text = "中等难度的游戏以五个家庭开局。提供衣物、

																食物、柴火、工具和建筑材料。已建好一座储物谷仓。	提供部分田地和果园的种子。"; }



		{ String _name = "EasyName";			String _text = "简单"; }

		{ String _name = "EasyDesc";			String _text = "简单难度的游戏以六个家庭开局。提供大量的衣物、

																食物、柴火、建筑材料和工具。住宅和储藏区域

																已经建好。提供田地和果园的种子，以及一群家畜。"; }



		{ String _name = "DSSVEasyCropsName";		String _text = "简单-作物 [DSSV]"; }

		{ String _name = "DSSVEasyCropsDesc";		String _text = "简单难度的游戏，附带所有作物种子。以六个家庭开局。1600 食物、30 衣物、30 工具、220 柴火、

