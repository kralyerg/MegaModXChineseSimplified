		{ String _name = "DSStoneBridgeMenuTip";		String _text = "DS 石桥。一座模块化桥梁，包含住宅、仓储、生产与服务设施。"; }
		
		{ String _name = "DSNormalStoneBridgeL";		String _text = "石桥左段"; }
		{ String _name = "DSNormalStoneBridgeLLwr";		String _text = "石桥左段"; }
		{ String _name = "DSNormalStoneBridgeLTip";		String _text = "普通构造桥的左段，从一岸架设至另一岸。地图朝北时，若以南北方向跨越，此桥段位于左侧；若以东西方向跨越，此桥段位于桥的上方或北侧。此桥段不含两端的坡道/台阶，需另行建造。每格需要 5 点工作量建造"; }
		
		{ String _name = "DSNormalStoneBridgeR";		String _text = "石桥右段"; }
		{ String _name = "DSNormalStoneBridgeRLwr";		String _text = "石桥右段"; }
		{ String _name = "DSNormalStoneBridgeRTip";		String _text = "普通构造桥的右段，从一岸架设至另一岸。地图朝北时，若以南北方向跨越，此桥段位于右侧；若以东西方向跨越，此桥段位于桥的下方或南侧。此桥段不含两端的坡道/台阶，需另行建造。每格需要 5 点工作量建造"; }
		
		
