StringTable resource
{
	Entry _strings
	[ 
		{ String _name = "DSStythTowerMenuTip";			String _text = "斯蒂斯塔楼 —— 为你的城镇提供的瞭望塔。配备人员后，它们会没收赃物，随机为城镇产生一批物资，这些赃物据推测来自土匪？还是外星人……"; }
	
		{ String _name = "DSStythTower";					String _text = "斯蒂斯塔楼"; }
		{ String _name = "DSStythTowerLwr";					String _text = "斯蒂斯塔楼"; }
		{ String _name = "DSStythTowerTip";					String _text = "斯蒂斯塔楼，最初版本的斯蒂斯瞭望塔，通过清除地区内的土匪为城镇产生少量随机物资（酒类、工具、衣物、食物等），城镇会获得这些战利品。可雇佣 1-2 名村庄卫兵。每张地图只能建造 1 座斯蒂斯塔楼。"; }
		
		{ String _name = "DSNewStythTower";					String _text = "新型斯蒂斯塔楼"; }
		{ String _name = "DSNewStythTowerLwr";				String _text = "新型斯蒂斯塔楼"; }
		{ String _name = "DSNewStythTowerTip";				String _text = "新型斯蒂斯塔楼，是经过更新的斯蒂斯塔楼，体型略大，这座瞭望塔通过清除地区内的土匪为城镇产生更多的随机物资（酒类、工具、衣物、食物、贵重品等），城镇会获得这些战利品。可雇佣 2-3 名村庄卫兵。每张地图只能建造 1 座新型斯蒂斯塔楼。"; }
		
		{ String _name = "ProfessionVillageGuard";			String _text = "村庄卫兵"; }
		{ String _name = "ProfessionVillageGuardTip";		String _text = "村庄卫兵受雇为城镇提供服务与保护。他们受雇于瞭望塔。众所周知，他们的死亡率高于其他职业。"; }
		{ String _name = "ProfessionVillageGuardDeath";		String _text = "在保护城镇免受土匪侵害后，因重伤而死。"; }
		
		
		{ String _name = "Gold";			String _text = "黄金"; }
		{ String _name = "Silver";			String _text = "白银"; }
		{ String _name = "Gems";			String _text = "宝石"; }
		
		{ String _name = "Lumber";			String _text = "木材"; }
	]
}
