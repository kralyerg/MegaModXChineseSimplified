	Entry _strings
	[ 
		{	String _name = "DSTunnelMineCCMenuTip";			String _text = "隧道矿场 —— 可开采石料、煤炭和铁矿石 —— 可选择建造随机资源生产矿场或指定资源生产矿场。"; }
		
		{	String _name = "DSTunnelMineCC";					String _text = "隧道矿场（随机）"; }
		{	String _name = "DSTunnelMineCCLwr";					String _text = "隧道矿场"; }
		{	String _name = "DSTunnelMineCCTip";					String _text = "随机资源生产矿场 —— 将矿场建于山体之中，最多可雇佣 8 名矿工随机开采石料、煤炭和铁矿石。（开采上限 2000）"; }
		
		{	String _name = "DSTunnelMineCCSelect";				String _text = "隧道矿场（指定）"; }
		{	String _name = "DSTunnelMineCCSelectLwr";			String _text = "隧道矿场"; }
		{	String _name = "DSTunnelMineCCSelectTip";			String _text = "指定资源生产矿场 —— 将矿场建于山体之中，最多可雇佣 8 名矿工，可通过界面选择开采石料、煤炭或铁矿石。（开采上限 2000）"; }
		
		{	String _name = "DSTunnelMineCCUp";					String _text = "隧道矿场升级"; }
