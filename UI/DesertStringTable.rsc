	//STARTING CONDITIONS

		{ String _name = "PalmsOnlyEasyName";		String _text = "棕榈树 - 简单"; }
		{ String _name = "PalmsOnlyEasyDesc";		String _text = "仅有棕榈树的标准简单难度游戏。简单难度以六个家庭开局，提供大量衣物、食物、柴火、建筑材料和工具，住房与储物区域已建好，田地和果园的种子以及一群牲畜均已备好。"; }

		{ String _name = "PalmsOnlyMediumName";		String _text = "棕榈树 - 中等"; }
		{ String _name = "PalmsOnlyMediumDesc";		String _text = "仅有棕榈树的标准中等难度游戏。中等难度以五个家庭开局，提供衣物、食物、柴火、工具和建筑材料，储物仓已建好，并备有一些田地和果园的种子。"; }

		{ String _name = "PalmsOnlyHardName";		String _text = "棕榈树 - 困难"; }
		{ String _name = "PalmsOnlyHardDesc";		String _text = "仅有棕榈树的标准困难难度游戏。困难难度以四个家庭开局，提供少量衣物、食物、柴火和工具，没有可供耕种的种子。"; }

		{ String _name = "PalmsOnlyAEName";		String _text = "棕榈树 - 亚当与夏娃"; }
		{ String _name = "PalmsOnlyAEDesc";		String _text = "仅有棕榈树的标准亚当与夏娃难度游戏。仅以 2 人开局，一辆小型储物车中备有少量食物、柴火和衣物。未建造任何建筑，初始也没有种子或牲畜——你必须自力更生，获取一切所需。"; }


