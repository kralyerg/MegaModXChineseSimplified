	// ------------ New Egypt Starting Conditions ---------------------------
		{ String _name = "EgyptEasyName";		String _text = "埃及 - 简单"; }
		{ String _name = "EgyptEasyDesc";		String _text = "一局仅有棕榈树的标准简单难度游戏。简单难度以六户家庭开局，提供大量衣物、食物、柴火、建筑材料和工具。住房和储物区域已经建好，同时可获得田地与果园用的种子及一群牲畜。"; }

		{ String _name = "EgyptMediumName";		String _text = "埃及 - 中等"; }
		{ String _name = "EgyptMediumDesc";		String _text = "一局仅有棕榈树的标准中等难度游戏。中等难度以五户家庭开局，提供衣物、食物、柴火、工具和建筑材料。储物仓已经建好，并提供部分田地与果园用的种子。"; }

		{ String _name = "EgyptHardName";		String _text = "埃及 - 困难"; }
		{ String _name = "EgyptHardDesc";		String _text = "一局仅有棕榈树的标准困难难度游戏。困难难度以四户家庭开局，提供少量衣物、食物、柴火和工具，没有可用于耕种的种子。"; }

		{ String _name = "EgyptAEName";			String _text = "埃及 - 亚当与夏娃"; }
		{ String _name = "EgyptAEDesc";			String _text = "一局仅有棕榈树的标准亚当与夏娃难度游戏。仅以 2 人开局，一辆小推车中提供少量食物、柴火和衣物。没有建成的建筑，也没有初始种子或牲畜——你必须自力更生，获取一切所需。"; }

	]
