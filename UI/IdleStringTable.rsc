			String _name = "UpChapelLwr";
			String _text = "★祝福教堂";
		}
		{
			String _name = "UpChapelTip";
			String _text = "获得St.Belle的祝福与哀雨之魂。祝福教堂将不再受火灾和龙卷风影响，此外教堂容量将翻倍。重建此建筑需要使用St.Belle之泪。哀雨之魂可以增强建筑功能。饲养St.Belle鸡即可获得St.Belle之泪，挖掘坟墓（需先拆除墓碑）可获得哀雨之魂。";
		}
