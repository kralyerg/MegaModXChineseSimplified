		{ String _name = "PineForesterFruitTip";			String _text = "一座枫木林业塔。林务员在此工作，负责种植、养护并采伐枫树、苹果树与橡树的木材。这些树木会为枫木采集者与松木捕猎者产出野生食物。"; }

		{ String _name = "PineForesterVanilla";				String _text = "原版林业塔"; }
