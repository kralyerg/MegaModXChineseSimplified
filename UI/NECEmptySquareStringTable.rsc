		{ String _name = "NECEmptySquare";				String _text = "空地方块"; }
		{ String _name = "NECEmptySquareLwr";				String _text = "空地方块"; }
		{ String _name = "NECEmptySquareTip";				String _text = "空地方块。这是一个1x1的地块，带有一个不可见的方形区域。设计用于在使用虚影装饰时，阻止村民通行以及树木等植物生长。"; }

		{ String _name = "NECEmptySquarePassable";			String _text = "可通行方块"; }
		{ String _name = "NECEmptySquarePassableLwr";			String _text = "可通行方块"; }
		{ String _name = "NECEmptySquarePassableTip";			String _text = "可通行的空地方块。这是一个1x1的地块，带有一个不可见的方形区域。设计用于放置在道路上，在使用虚影装饰时允许村民通行，但阻止树木等植物生长。"; }

		{ String _name = "NECEmptyField";				String _text = "空地地块"; }
		{ String _name = "NECEmptyFieldLwr";				String _text = "空地地块"; }
		{ String _name = "NECEmptyFieldTip";				String _text = "空地地块。这是一个可拖拽的不可见区域，可阻止野生树木及资源生长。非常适合放置在湖泊、池塘等大型装饰区域之下。如有需要，村民仍可从该区域上方通过。"; }

		{ String _name = "NECEmptyTrash";				String _text = "清除"; }
		{ String _name = "NECEmptyTrashLwr";				String _text = "清除"; }
		{ String _name = "NECEmptyTrashTip";				String _text = "清除除除除除除除除除除除。"; }		
	]	
