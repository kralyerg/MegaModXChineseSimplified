		{ String _name = "Quote2";				String _text = "「O」殖民地最黑暗的秘密就是还是有不少人相信他们处于另一个更高级的文明统治下"; }
		{ String _name = "Quote3";				String _text = "「O」这他妈当然是匹马！"; }
		{ String _name = "QuoteIron1";				String _text = "「O」我们必须认识到我们将成为一座山上的城。所有人的眼睛都在看着我们。 - 约翰·温斯洛普."; }
		{ String _name = "QuoteJade1";				String _text = "「O」诸佛世尊，皆出人间，非由天而得 - 释迦牟尼"; }
