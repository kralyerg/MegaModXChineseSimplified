		{ String _name = "NMT30StorageBarnSmallLwr";			String _text = "小谷仓"; }

		{ String _name = "NMT30StorageBarnSmallTip";			String _text = "小型谷仓用于存放食物、衣物、纺织品和工具等物品。尺寸：3x5。花费：24原木、8石头。容量：3800重量。可存放：食物、工具、草药、衣物、纺织品、谷物、蔬菜、水果、蛋白质类、手工制品、锻造品、织物、珍贵物品、杂项。提示：这座谷仓是中型谷仓的缩小版本，更便宜、尺寸更小，容量也更小。"; }



		{ String _name = "NMT30StorageBarnTiny";			String _text = "迷你谷仓"; }

		{ String _name = "NMT30StorageBarnTinyLwr";			String _text = "迷你谷仓"; }

		{ String _name = "NMT30StorageBarnTinyTip";			String _text = "迷你谷仓用于存放食物、衣物、纺织品和工具等物品。尺寸：2x3。花费：16原木、4石头。容量：1600重量。可存放：食物、工具、草药、衣物、纺织品、谷物、蔬菜、水果、蛋白质类、手工制品、锻造品、织物、珍贵物品、杂项。提示：这座谷仓是小型谷仓的迷你版本，花费便宜得多，尺寸也是迷你型，容量同样很小。"; }



		{ String _name = "NMT30Granary";				String _text = "谷物仓"; }

		{ String _name = "NMT30GranaryLwr";				String _text = "谷物仓"; }

		{ String _name = "NMT30GranaryTip";				String _text = "谷物仓是一种专用储存空间，只用于存放食物（可食用与不可食用）。尺寸：5x8。花费：58原木、16石头。容量：12000重量。可存放：食物、谷物、蔬菜、水果、蛋白质类。提示：这座谷物仓是一种谷仓，但只存放食物（可食用与不可食用），且每格容量更高。花费比普通谷仓略高。"; }



		{ String _name = "NMT30RootCellar";				String _text = "地窖"; }

		{ String _name = "NMT30RootCellarLwr";				String _text = "地窖"; }

		{ String _name = "NMT30RootCellarTip";				String _text = "地窖是一种专用的地下储存空间，只用于存放水果/蔬菜。尺寸：4x5。花费：6原木、26石头。容量：8000重量。可存放：蔬菜、水果。提示：这座地窖是一种地下版的谷仓，但只存放水果和蔬菜，且每格的容量要高得多。花费的石头比原木更多。"; }



		{ String _name = "RKmeatLocker";				String _text = "肉窖"; }

		{ String _name = "RKmeatLockerLwr";				String _text = "肉窖"; }

		{ String _name = "RKmeatLockerTip";				String _text = "肉窖是一种专用的半地下储存空间，只用于存放肉类/蛋白质。尺寸：3x3格。花费：5原木、12石头。容量：3600重量。可存放：蛋白质类。提示：这座肉窖是一种半地下版的谷仓，但只存放肉类和蛋白质，且每格的容量要高得多。花费的石头比原木更多。"; }



		{ String _name = "NMT30BarberShop";				String _text = "理发店"; }

		{ String _name = "NMT30BarberShopLwr";				String _text = "理发店"; }

		{ String _name = "NMT30BarberShopTip";				String _text = "理发店是由一名医生驻守、帮助维护居民健康的场所。尺寸：4x5格。花费：8原木、24木料、32石头、8玻璃、12香水、1银。容量：10人。雇佣：1名医生。提示：这是医院的缩小版本，作用方式相同，只能接待10名病患。其设计适合安置在多层住宅下方，不会吸引游手好闲的居民。"; }



		{ String _name = "NMT30Dentist";				String _text = "牙医"; }

		{ String _name = "NMT30DentistLwr";				String _text = "牙医"; }

		{ String _name = "NMT30DentistTip";				String _text = "牙医是由一名医生驻守、帮助维护居民健康的场所。尺寸：4x5格。花费：8原木、24木料、32石头、8玻璃、6铜、1金。容量：10人。雇佣：1名医生。提示：这是医院的缩小版本，作用方式相同，只能接待10名病患。其设计适合安置在多层住宅下方，不会吸引游手好闲的居民。"; }



		{ String _name = "NMT30Clinic";					String _text = "诊所"; }

		{ String _name = "NMT30ClinicLwr";				String _text = "诊所"; }

		{ String _name = "NMT30ClinicTip";				String _text = "诊所是由一名医生驻守、帮助维护居民健康的场所。尺寸：4x5格。花费：8原木、24木料、32石头、8玻璃、18玻璃器皿、24草药。容量：20人。雇佣：1名医生。提示：这是医院的缩小版本，作用方式相同，只能接待10名病患。其设计适合安置在多层住宅下方，不会吸引游手好闲的居民。"; }



		{ String _name = "NMT30BathHouse";				String _text = "浴室"; }

		{ String _name = "NMT30BathHouseLwr";				String _text = "浴室"; }

		{ String _name = "NMT30BathHouseTip";				String _text = "浴室是维护卫生、帮助保持居民健康的重要场所。尺寸：8x6格。花费：24木料、56石头、24玻璃、8铜、24香水、36草药。快乐度类型：健康。半径：60。容量：200人。雇佣：1名工人。提示：这是一座半径很大的大型建筑，能提供快乐度：健康，并会吸引游手好闲的居民。其设计适合安置在多层住宅下方。"; }



		{ String _name = "NMT30SchoolHouse";				String _text = "中世纪学校"; }

		{ String _name = "NMT30SchoolHouseLwr";				String _text = "中世纪学校"; }

		{ String _name = "NMT30SchoolHouseTip";				String _text = "中世纪学校用于教育居民，使其提高生产效率。尺寸：5x5格。花费：48木料、26石头、12铁、8铜、24玻璃。容量：40人。雇佣：1名教师。提示：这是一座教育建筑，与普通学校相比学生容量翻倍。教育在本模组中至关重要，缺乏教育会大幅增加游戏难度。"; }



		{ String _name = "RKShopHardware";				String _text = "原材料"; }

		{ String _name = "RKShopHardwareLwr";				String _text = "原材料"; }

		{ String _name = "RKShopHardwareTip";				String _text = "原材料商店是一处只出售原材料（木材、矿物、铁）的小型市场。尺寸：4x5格。花费：24原木、36石头。出售：（30%）原木（40%）矿物（30%）铁。容量：10000重量。雇佣：1-6名商贩。提示：这是一处为铁匠铺、铸造厂及任何需要原木+铁和/或矿物的生产建筑供货的好市场，适合安置在多层住宅下方。"; }



		{ String _name = "RKShopBuilding";				String _text = "建筑材料"; }

		{ String _name = "RKShopBuildingLwr";				String _text = "建筑材料"; }

		{ String _name = "RKShopBuildingTip";				String _text = "建筑材料商店是一处只出售二级建筑材料（石头、建材类：木料、玻璃、砖块、屋瓦……）的小型市场。尺寸：4x5格。花费：24原木、36石头。出售：（20%）石头（80%）建材。容量：10000重量。雇佣：1-6名商贩。提示：这是一处为正在开发的区域提供建筑材料的好市场，适合安置在多层住宅下方。"; }



		{ String _name = "RKShopGrocery";				String _text = "杂货店"; }

		{ String _name = "RKShopGroceryLwr";				String _text = "杂货店"; }

		{ String _name = "RKShopGroceryTip";				String _text = "杂货店是一处只出售食物（蛋白质类、谷物、蔬菜和水果）的小型市场。尺寸：4x5格。花费：24原木、36石头。出售：食物（25%）谷物（25%）水果（25%）蔬菜（25%）蛋白质类。容量：10000重量。雇佣：1-6名商贩。提示：这是一处为住宅区提供食物的好市场，会收集可食用与不可食用的食物，适合安置在多层住宅下方。"; }



		{ String _name = "RKShopDelicate";				String _text = "用品杂货"; }

		{ String _name = "RKShopDelicateLwr";				String _text = "用品杂货"; }

		{ String _name = "RKShopDelicateTip";				String _text = "用品杂货是一处只出售各类日用品的小型市场。尺寸：4x5格。花费：24原木、36石头。出售：（25%）工具（25%）燃料（25%）衣物（25%）医疗用品。容量：10000重量。雇佣：1-6名商贩。提示：这是一处为住宅区提供除食物以外一切物资的好市场，应能为你所有的住宅提供除食物外的一切所需，适合安置在多层住宅下方。"; }



		{ String _name = "RKShopFabrics";				String _text = "织物商行"; }

		{ String _name = "RKShopFabricsLwr";				String _text = "织物商行"; }

		{ String _name = "RKShopFabricsTip";				String _text = "织物商行是一处只出售制衣用织物材料（纺织品与织物）的小型市场。尺寸：4x5格。花费：24原木、36石头。出售：（50%）纺织品（50%）织物。容量：10000重量。雇佣：1-6名商贩。提示：这是一处为裁缝店及任何需要纺织品的地方供货的好市场，适合安置在多层住宅下方。"; }



		{ String _name = "NewMedievalFlatTool";			String _text = "平地工具"; }

		{ String _name = "NewMedievalFlatToolLwr";		String _text = "平地工具"; }

		{ String _name = "NewMedievalFlatToolTip";		String _text = "平地工具用于在删除运河、池塘或露天矿场后，将地面恢复平整……对于铲平山丘也非常有用。它会在地面上留下一个橙色的X标记。任务完成后，你需要使用移除建筑工具来清除这个橙色的X标记。"; }



		{ String _name = "NMTMCsandpit";			String _text = "沙坑"; }

		{ String _name = "NMTMCsandpitLWR";			String _text = "沙坑"; }

		{ String _name = "NMTMCsandpitTip";			String _text = "沙坑是一处可以采集沙子的作业区域。尺寸：9x9格。花费：12原木。可产出：6-9沙子。容量：无限制。雇佣：1-6名采石工。提示：每次作业可产出6-9沙子。沙子是价值为1的材料。请注意不要挡住入口，并在其前方留出一条道路。"; }



		{ String _name = "NMTMCclaypit";			String _text = "黏土坑"; }

		{ String _name = "NMTMCclaypitLWR";			String _text = "黏土坑"; }

		{ String _name = "NMTMCclaypitTip";			String _text = "黏土坑是一处可以采集黏土的作业区域。尺寸：9x9格。花费：12原木。可产出：1-2黏土。容量：无限制。雇佣：1-6名采石工。提示：每次作业可产出1-2黏土。黏土是价值为3的材料。请注意不要挡住入口，并在其前方留出一条道路。"; }



		{ String _name = "NMTMCkiln";				String _text = "窑"; }

		{ String _name = "NMTMCkilnLWR";			String _text = "窑"; }

		{ String _name = "NMTMCkilnTip";			String _text = "窑是一处可以用黏土制作砖块和屋瓦的作业区域。尺寸：6x6格。花费：26石头。可制作：用10黏土制作6-10砖块，或用10黏土制作6-10屋瓦。雇佣：1名工人。提示：每次作业还需要2柴火。砖块和屋瓦都是价值为5的建材物品，许多建筑都需要用它们作为建筑材料。"; }



		{ String _name = "NMTMCglassmaker";			String _text = "玻璃匠"; }

		{ String _name = "NMTMCglassmakerLWR";			String _text = "玻璃匠"; }

		{ String _name = "NMTMCglassmakerTip";			String _text = "玻璃匠是一处可以用沙子制作玻璃和玻璃器皿的作业区域。尺寸：6x6格。花费：38原木、32石头、12铁。可制作：用23沙子制作6-8玻璃，或用23沙子制作6-9玻璃器皿。雇佣：1名工人。提示：每次作业还需要6柴火或3煤炭。玻璃是价值为8的建材物品，玻璃器皿是价值为7的手工制品。许多建筑都需要玻璃作为建筑材料，玻璃器皿则用于生产或作为建筑材料。"; }



		{ String _name = "NMT30MCironQuarry";			String _text = "铁矿场"; }

		{ String _name = "NMT30MCironQuarryLWR";		String _text = "铁矿场"; }

		{ String _name = "NMT30MCironQuarryTip";		String _text = "铁矿场是一处可以开采铁或铜的作业区域。尺寸：10x10格。花费：48原木。可产出：每次作业2-3铁矿石或2-3铜矿石。容量：2000。雇佣：1-6名矿工。提示：铁矿石和铜矿石是价值为4的矿物。你需要一座铸造厂来熔炼这些矿石。（在你拥有铸造厂之前，铁匠铺也可以帮上忙。）矿场枯竭后，你可以将其更新5次。"; }



		{ String _name = "NMT30MCrockQuarry";			String _text = "采石场"; }

		{ String _name = "NMT30MCrockQuarryLWR";		String _text = "采石场"; }

		{ String _name = "NMT30MCrockQuarryTip";		String _text = "采石场是一处可以开采石头、煤炭或盐的作业区域。尺寸：10x10格。花费：48原木。可产出：每次作业1-2石头，或3-4煤炭，或4-6盐。容量：2000。雇佣：1-6名矿工。提示：石头属于石料限额类，价值为8。煤炭是价值为4的矿物。盐是价值为1的矿物。矿场枯竭后，你可以将其更新5次。"; }



		{ String _name = "NMT30MCrandomQuarry";			String _text = "随机矿场"; }

		{ String _name = "NMT30MCrandomQuarryLWR";		String _text = "随机矿场"; }

		{ String _name = "NMT30MCrandomQuarryTip";		String _text = "随机矿场是一处可以随机开采到各种资源的作业区域。尺寸：10x10格。花费：48原木。随机产出：每次作业1-2石头、3-4煤炭、4-6盐、2-3铁矿石、2-3铜矿石。容量：2000。雇佣：1-6名矿工。提示：石头价值为8。煤炭、铁矿石和铜矿石是价值为4的矿物。盐是价值为1的矿物。矿场枯竭后，你可以将其更新5次。这座随机矿场还可能给你1颗宝石（价值200）、1-2银矿石（价值11）和1-2金矿石（价值22）。这些同样属于矿物。"; }



