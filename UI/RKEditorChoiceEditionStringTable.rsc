		{ String _name = "NMT30MCrockQuarryLvl5Tip";		String _text = "采石场 5级是一处可以开采石头、煤炭或盐的作业区域。"; }



		{ String _name = "NMT30MCrandomQuarryLvl5";		String _text = "随机矿场 5级"; }

		{ String _name = "NMT30MCrandomQuarryLvl5LWR";		String _text = "随机矿场 5级"; }

		{ String _name = "NMT30MCrandomQuarryLvl5Tip";		String _text = "随机矿场 5级是一处可以随机开采到各种资源……的作业区域。"; }



		{ String _name = "NMT30Foundry";			String _text = "铸造厂"; }

		{ String _name = "NMT30FoundryLWR";			String _text = "铸造厂"; }

		{ String _name = "NMT30FoundryTip";			String _text = "铸造厂是一处可以熔炼一切的作业区域。尺寸：8x8格。花费：24原木、64石头、18铁、32木炭。可产出：每次作业1-2铁、铜、银或金。雇佣：1-2名铁匠。提示：铸造厂是游戏中熔炼一切物资的最佳选择，效率也比普通铁匠铺建筑更高。"; }



		{ String _name = "NMT30JewelMaker";			String _text = "珠宝匠"; }

		{ String _name = "NMT30JewelMakerLWR";			String _text = "珠宝匠"; }

		{ String _name = "NMT30JewelMakerTip";			String _text = "珠宝匠用贵金属和宝石制作非常珍贵的戒指、项链和珠宝。尺寸：6x6格。花费：8原木、24木料、16石头、18砖块、6玻璃。可制作：用切割好的宝石与金/银制作珠宝，配方多种多样。雇佣：1名工人。提示：你需要宝石切割匠来切割这些宝石，一旦确定其价值，就可以用来制作银版或金版的珠宝。每种配方每次都会产出不止一件物品。不过，缺乏教育对这座建筑非常不利。配方清单太长，这里就不一一列出了。"; }



		{ String _name = "NMT30GemCutter";			String _text = "宝石切割匠"; }

		{ String _name = "NMT30GemCutterLWR";			String _text = "宝石切割匠"; }

		{ String _name = "NMT30GemCutterTip";			String _text = "宝石切割匠会切割宝石，鉴定其品质与价值。尺寸：6x6格。花费：8原木、24木料、16石头、18砖块、6玻璃。可制作：紫水晶（价值60）、黄玉（价值80）、祖母绿（价值250）、蓝宝石（价值300）、红宝石（价值400）、钻石（价值1000）。雇佣：1名工人。提示：获得未切割宝石的唯一途径是随机矿场。当然，价值越高的宝石也越稀有。"; }



		{ String _name = "NMT30CandleMaker";			String _text = "蜡烛匠"; }

		{ String _name = "NMT30CandleMakerLWR";			String _text = "蜡烛匠"; }

		{ String _name = "NMT30CandleMakerTip";			String _text = "蜡烛匠用蜂蜡制作蜡烛。尺寸：6x6格。花费：12原木、24木料、18石头、24砖块、12玻璃。可制作：每次作业用16蜂蜡制作3-4蜡烛。雇佣：1名工人。提示：蜡烛的价值为8。矿场和采石场枯竭后，需要用蜡烛来升级和更新它们。"; }



		{ String _name = "NMT30MineUpgradeTip";			String _text = "将这座矿场/采石场升级并更新到更深的一级，即使原本已经枯竭，也能让你继续从中获取资源。为此你需要额外的材料，例如蜡烛。"; }



		{ String _name = "RKGardenWallsGreenHouse";			String _text = "温室"; }

		{ String _name = "RKGardenWallsGreenHouseLwr";			String _text = "温室"; }

		{ String _name = "RKGardenWallsGreenHouseTip";			String _text = "温室是本模组中产出食物效率最高的建筑。尺寸：5x7格。花费：20木料、20石头、48玻璃。可制作：游戏中所有种类的蔬菜，以及一些小型水果作物，产出数量在16-24到20-28之间不等。雇佣：1名植物学家。提示：温室每次作业都需要持续消耗（2）肥料和（2）水（肥料的最佳来源是马厩，饲养了一些动物的牧场也会有很大帮助；水来自水井或水塔）。"; }



		{ String _name = "RKGardenWallsStables";			String _text = "马厩"; }

		{ String _name = "RKGardenWallsStablesLwr";			String _text = "马厩"; }

		{ String _name = "RKGardenWallsStablesTip";			String _text = "马厩是游戏中最好的肥料来源。尺寸：9x6格。花费：20木料、40石头。可产出：每次作业用2饲料茅草和2水制作3-5肥料（价值2）。雇佣：1-2名马夫。提示：你需要充足的饲料茅草来源，可以来自清理土地或饲料农夫，还需要来自水井或水塔的水。肥料用于温室（每格产出食物效率最高的建筑）。"; }



		{ String _name = "RKGardenWallsWell";				String _text = "水井"; }

		{ String _name = "RKGardenWallsWellLwr";			String _text = "水井"; }

		{ String _name = "RKGardenWallsWellTip";			String _text = "水井是一处优质的淡水来源。尺寸：1x1格（含道路为3x3）。花费：4木料、24石头。可产出：每次作业12-15水（价值1）。雇佣：1名工人。提示：这口水井不能用于灭火。它的产水速度比水塔慢。水是一种不含营养的食物（没有饮食标记），在马厩、温室、香水坊、药房等许多产业中都需要用到……"; }



		{ String _name = "RKGardenWallsFodderFarmers";			String _text = "饲料农夫"; }

		{ String _name = "RKGardenWallsFodderFarmersLwr";		String _text = "饲料农夫"; }

		{ String _name = "RKGardenWallsFodderFarmersTip";		String _text = "饲料农夫会种植草地，并在草长成后收获饲料茅草（而不是种树）。尺寸：5x6格。花费：32木料、4石头。可产出：每片已收获的草丛3-4饲料茅草。半径：26格。雇佣：1-3名林务员。提示：其工作方式与林务员小屋完全相同，但种植的是草而非树。首先他们需要清理半径范围内的一切，移除所有树木，清除所有矿石会对他们很有帮助，清理完成后，他们会种下一片草地。这片草需要生长，成熟后才会被收获。饲料也可以被制成柴薪捆（即柴火）。"; }



		{ String _name = "RKGardenWallsFlorist";			String _text = "花匠"; }

		{ String _name = "RKGardenWallsFloristLwr";			String _text = "花匠"; }

		{ String _name = "RKGardenWallsFloristTip";			String _text = "花匠会四处游荡并尝试采集鲜花。尺寸：5x6格。花费：32木料、4石头。可产出：每片已采集的花丛3-5朵鲜花。半径：32。雇佣：1名采集者。提示：花匠的行为与采集者完全相同，但会搜索鲜花和树苗。不建议将其安置在林务员/采集者组合附近（效果很差），而应与饲料农夫建筑搭配使用。草地会生成大量鲜花。警告：花匠不会种植鲜花。"; }



		{ String _name = "RKGardenWallsPerfumery";			String _text = "香水坊"; }

		{ String _name = "RKGardenWallsPerfumeryLwr";			String _text = "香水坊"; }

		{ String _name = "RKGardenWallsPerfumeryTip";			String _text = "香水坊用鲜花精华制作香水。尺寸：5x5格。花费：24木料、24石头、8铜、12玻璃器皿。可制作：每次作业用8鲜花、2水、1玻璃器皿制作5-8香水（价值8）。雇佣：1名工人。提示：这是最适合出售的物品之一，因为它使用的原料——鲜花——随处可得。这座建筑需要持续供应水和玻璃器皿。水来自水井或水塔，玻璃器皿来自玻璃匠。"; }



		{ String _name = "RKGardenWallsCustom5Barn";			String _text = "饲料谷仓"; }

		{ String _name = "RKGardenWallsCustom5BarnLwr";			String _text = "饲料谷仓"; }

		{ String _name = "RKGardenWallsCustom5BarnTip";			String _text = "这是一座饲料谷仓，只允许存放饲料类物品及所有归属该类别的物品。尺寸：4x4格。花费：12原木、28饲料茅草。容量：6000重量。可存放：杂项物品。提示：饲料带有杂项标记，因此这里可以存放所有杂项标记的物品。在同样4x4的尺寸下，能比普通堆场存放更多物品。"; }



		{ String _name = "RKGardenWallsTrash";				String _text = "垃圾"; }

		{ String _name = "RKGardenWallsTrashLwr";			String _text = "垃圾"; }

		{ String _name = "RKGardenWallsTrashTip";			String _text = "丢弃此物品并将其移除。"; }

		{ String _name = "RKGardenWallsTrashUpgradeTip";		String _text = "丢弃此物品并将其移除。"; }



		{ String _name = "OldBarnPub";				String _text = "老谷仓酒馆"; }

		{ String _name = "OldBarnPubLWR";			String _text = "老谷仓酒馆"; }

		{ String _name = "OldBarnPubTip";			String _text = "老谷仓酒馆是一座由谷仓改造而成的酒吧/酒馆。它们会提供餐食和饮品，并营造出欢乐的氛围以带来快乐度。尺寸：6x6格。花费：32原木、16石头。快乐度类型：娱乐。半径：40格。雇佣：1-3名酿酒师。提示：这座建筑使用了一个新标记：消耗。这个特殊标记有助于处理酒类，作用方式相同。酿酒师会取用二级肉类、一种蔬菜和一种酒类，制作出12-16份餐食（价值1）。居民会取用餐食并从中获得快乐度（与麦酒完全相同），但花费要低得多。"; }





		{ String _name = "ClearWildFood";			String _text = "采集野生食物"; }

		{ String _name = "ClearWildFoodLwr";			String _text = "采集野生食物"; }

		{ String _name = "ClearWildFoodTip";			String _text = "在所选区域内采集并收获野生食物点。提示：野生食物会从树木中生成，还有大量新的食物会从鲜花中生成。"; }



		{ String _name = "ClearFodder";				String _text = "采集饲料"; }

		{ String _name = "ClearFodderLwr";			String _text = "采集饲料"; }

		{ String _name = "ClearFodderTip";			String _text = "在所选区域内采集并收获饲料茅草地。提示：饲料茅草是你从地面上可见的草丛中采集获得的材料。饲料可用于马厩，也可以被伐木工制成柴薪捆（即柴火），还可作为建筑材料使用（养蜂场、无栅栏牧场、饲料谷仓……）。每片草丛可产出4-6饲料茅草（价值1），它们会被存放在建材堆场中。"; }



		{ String _name = "ClearFlower";				String _text = "采集鲜花"; }

		{ String _name = "ClearFlowerLwr";			String _text = "采集鲜花"; }

		{ String _name = "ClearFlowerTip";			String _text = "在所选区域内采集并收获鲜花点。提示：鲜花带有杂项标记。每片花丛可产出3-5朵鲜花（价值1）。请确保你有可接受杂项物品的谷仓。"; }



		{ String _name = "ClearHerb";				String _text = "采集草药"; }

		{ String _name = "ClearHerbLwr";			String _text = "采集草药"; }

		{ String _name = "ClearHerbTip";			String _text = "在所选区域内采集并收获草药点。提示：草药在草药师（或浴室）处使用，每次使用可恢复半颗心。每片草药丛可产出2-3份草药（价值4）。草药需要谷仓类型的存储空间。"; }



		{ String _name = "ClearCopper";				String _text = "采集铜"; }

		{ String _name = "ClearCopperLwr";			String _text = "采集铜"; }

		{ String _name = "ClearCopperTip";			String _text = "采集所选区域内的所有铜以及其他稀有矿物（金和银）。提示：铜可用于制作一些工具，也可作为建筑材料。铜和其他稀有矿石都属于矿物。请确保你有可用的材料堆场。可开采出2-3铜矿石（价值4）、1-2银矿石（价值11）或1-2金矿石（价值22）。请确保你有可用的矿物堆场来存放这些物品。"; }



		{ String _name = "ClearAlmostAll";			String _text = "采集几乎所有物品"; }

		{ String _name = "ClearAlmostAllLwr";			String _text = "采集几乎所有物品"; }

		{ String _name = "ClearAlmostAllTip";			String _text = "采集所选区域内的所有矿石和石头。提示：这个特殊工具会收集所有矿石和所有石头，不会清除树木、草地以及其他有价值的野生物。非常适合快速清理林务员周边的土地。"; }



		{ String _name = "ClearFirewood";			String _text = "采集枯木"; }

		{ String _name = "ClearFirewoodLwr";			String _text = "采集枯木"; }

		{ String _name = "ClearFirewoodTip";			String _text = "采集所选区域内的所有枯木作为柴火。提示：枯木是倒下的死树。采集枯木点每棵死树可产出5-8柴火。"; }



		{ String _name = "BostonHouse";				String _text = "波士顿屋"; }

		{ String _name = "BostonHouseLwr";			String _text = "波士顿屋"; }

		{ String _name = "BostonHouseTip";			String _text = "波士顿屋。每位居民都会喜欢住在多彩的波士顿屋里。尺寸：4x5格。花费：54木料、6石头和30玻璃。居住人数：6名居民。保温效率%：108。模型数：1。颜色：8种可选。提示：按F键更换颜色。"; }



		{ String _name = "BostonHouse2";			String _text = "波士顿屋2号"; }

		{ String _name = "BostonHouse2Lwr";			String _text = "波士顿屋2号"; }

		{ String _name = "BostonHouse2Tip";			String _text = "波士顿屋2号（不同的材质与模型）。每位居民都会喜欢住在多彩的波士顿屋里。尺寸：4x5格。花费：54木料、6石头和30玻璃。居住人数：6名居民。保温效率%：108。模型数：1。颜色：10种可选。提示：按F键更换颜色。"; }



		{ String _name = "LittleHouseToolbar";			String _text = "彩色小屋工具栏"; }

		{ String _name = "LittleHouseToolbarLwr";		String _text = "彩色小屋工具栏"; }

		{ String _name = "LittleHouseToolbarTip";		String _text = "打开此工具栏以获取彩色小屋的选项。提示：这套套装包含一层建筑，以及一个可叠加在一层之上、供第二个家庭使用的特殊二层。可容纳5人，保温效率%为80。共12种不同颜色。按F键更换颜色。"; }



		{ String _name = "LittleHouse01";			String _text = "彩色小屋"; }

		{ String _name = "LittleHouse01Lwr";			String _text = "彩色小屋"; }

		{ String _name = "LittleHouse01Tip";			String _text = "彩色小屋用于安置你的居民。尺寸：3x5格。花费：24原木、6石头。居住人数：5名居民。保温效率%：80。模型数：1。颜色：12种可选。提示：按F键更换颜色。"; }



		{ String _name = "LittleHouse01floor2";			String _text = "彩色小屋2层"; }

		{ String _name = "LittleHouse01floor2Lwr";		String _text = "彩色小屋2层"; }

		{ String _name = "LittleHouse01floor2Tip";		String _text = "彩色二层用于安置第二个家庭。尺寸：1x5格。花费：32原木、6石头。居住人数：6名居民。保温效率%：90。模型数：1。颜色：12种可选。提示：它应放置在一层的右侧，请确保后方的烟囱对齐；它需要完美地叠放在一层之上。按F键更换颜色。"; }





		{ String _name = "NMT30MultiStoryHousingToolbar";			String _text = "NMT多层住宅工具栏"; }

		{ String _name = "NMT30MultiStoryHousingToolbarLwr";			String _text = "NMT多层住宅工具栏"; }

		{ String _name = "NMT30MultiStoryHousingToolbarTip";			String _text = "NMT多层住宅工具栏。打开此工具栏以获取NMT多层住宅的选项。提示：多层住宅是三层建筑。它们有不同的外形、花费与材质，但尺寸始终为：1x5 + 4x5 + 1x5。二层位于一层右侧，三层位于一层左侧。它们可容纳5-6人，保温效率%范围为72至114。"; }



		{ String _name = "NMT3Texture1";			String _text = "NMT多层经典石屋工具栏"; }

		{ String _name = "NMT3Texture1Lwr";			String _text = "NMT多层建筑工具栏"; }

		{ String _name = "NMT3Texture1Tip";			String _text = "NMT多层经典石屋工具栏。打开此工具栏以获取NMT多层住宅的选项。提示：它们需要木料、石头、铁、玻璃和原木。保温效率%范围为92至96。"; }



