		{ String _name = "NMT3Texture4Lwr";			String _text = "NMT多层建筑工具栏"; }

		{ String _name = "NMT3Texture4Tip";			String _text = "NMT多层沙砖屋工具栏。打开此工具栏以获取NMT多层住宅的选项。提示：它们需要木料、砖块、石头、玻璃和屋瓦。保温效率%范围为106至114。"; }



		{ String _name = "NMT3Texture5";			String _text = "NMT多层火砖屋工具栏"; }

