		{ String _name = "NMT3Texture2Lwr";			String _text = "NMT多层建筑工具栏"; }

		{ String _name = "NMT3Texture2Tip";			String _text = "NMT多层老石屋工具栏。打开此工具栏以获取NMT多层住宅的选项。提示：它们需要木料、石头、铁、玻璃和原木。保温效率%范围为92至96。"; }



		{ String _name = "NMT3Texture3";			String _text = "NMT多层红砖屋工具栏"; }

		{ String _name = "NMT3Texture3Lwr";			String _text = "NMT多层建筑工具栏"; }

		{ String _name = "NMT3Texture3Tip";			String _text = "NMT多层红砖屋工具栏。打开此工具栏以获取NMT多层住宅的选项。提示：它们需要木料、砖块、石头、玻璃和屋瓦。保温效率%范围为106至114。"; }



