		{ String _name = "OrchardLodgesToolbar";		String _text = "果园林场工具栏"; }

		{ String _name = "OrchardLodgesToolbarLwr";		String _text = "果园林场工具栏"; }

		{ String _name = "OrchardLodgesToolbarTip";		String _text = "果园林场工具栏。打开此工具栏以获取果园林场的选项。（用于划定一片区域，有选择地砍伐树木并种植新的果树苗。花费：32木材、12石头。半径：24格。雇佣：1-2名林务员。）"; }



		{ String _name = "OrchardLodges2Toolbar";		String _text = "热带林场工具栏"; }

		{ String _name = "OrchardLodges2ToolbarLwr";		String _text = "热带林场工具栏"; }

		{ String _name = "OrchardLodges2ToolbarTip";		String _text = "热带林场工具栏。打开此工具栏以获取热带果园林场的选项。（用于划定一片区域，有选择地砍伐树木并种植新的热带果树苗。花费：32木材、12石头。半径：24格。雇佣：1-2名林务员。）"; }



		{ String _name = "OrchardLodgeAppleTree";		String _text = "苹果林场"; }

		{ String _name = "OrchardLodgeAppleTreeLwr";		String _text = "苹果林场"; }

		{ String _name = "OrchardLodgeAppleTreeTip";		String _text = "用于划定一片区域，有选择地砍伐树木并种植新的苹果树苗。尺寸：5x6格。花费：32原木、12石头。半径：24格。雇佣：1-2名林务员。提示：区域内的一切都会被清除，并替换为一棵苹果树，随着时间推移会持续结出大量苹果。它就像果园，但采用林务员小屋的运作方式。"; }



		{ String _name = "OrchardLodgeApricotTree";		String _text = "杏林场"; }

		{ String _name = "OrchardLodgeApricotTreeLwr";		String _text = "杏林场"; }

		{ String _name = "OrchardLodgeApricotTreeTip";		String _text = "用于划定一片区域，有选择地砍伐树木并种植新的杏树苗。尺寸：5x6格。花费：32原木、12石头。半径：24格。雇佣：1-2名林务员。提示：区域内的一切都会被清除，并替换为一棵杏树，随着时间推移会持续结出大量杏。它就像果园，但采用林务员小屋的运作方式。"; }



