		{ String _name = "PastureFenceless";			String _text = "无栅栏牧场"; }

		{ String _name = "PastureFencelessLwr";			String _text = "无栅栏牧场"; }

		{ String _name = "PastureFencelessTip";			String _text = "无栅栏牧场提供一片供牲畜放牧的区域。尺寸：7x7至30x30。花费：每格1饲料茅草。雇佣：1-4名牧人。提示：使用R或T键旋转牧场，确保动物棚舍尽量靠近谷仓，并位于山坡地形中。"; }



		{ String _name = "MarketMed";				String _text = "市场"; }

		{ String _name = "MarketMedLwr";			String _text = "市场"; }

		{ String _name = "MarketMedTip";			String _text = "用于在局部区域为居民提供食物、工具和燃料。尺寸：10x10。花费：32木料、30石头、22铁。容量：12000重量。半径：36格。存放：食物、燃料、工具、医疗用品、衣物。雇佣：1-8名商贩。提示：为居民住宅提供物资的最佳选择之一，规模比大市场小。"; }



		{ String _name = "RKFCLumbermill";			String _text = "制材厂"; }

		{ String _name = "RKFCLumbermillLwr";			String _text = "制材厂"; }

		{ String _name = "RKFCLumbermillTip";			String _text = "制材厂用原木制作木料。尺寸：5x6。花费：48原木、6石头。可制作：木料、柴火。雇佣：1-3名伐木工。提示：制材厂是早期定居点建筑，所有二级以上的建筑都需要木料。如有需要它也可以制作柴火。按F键切换其他屋顶颜色。"; }



		{ String _name = "RKFCForestBarn";			String _text = "森林谷仓"; }

		{ String _name = "RKFCForestBarnLwr";			String _text = "森林谷仓"; }

		{ String _name = "RKFCForestBarnTip";			String _text = "森林谷仓可以存放森林哨站产出的所有物品。尺寸：5x6。花费：48原木、12石头。容量：12000重量。可存放：食物、工具、医疗用品、燃料、木材、纺织品、谷物、蔬菜、水果、蛋白质类。提示：非常适合存放来自森林哨站的简单物资。"; }



		{ String _name = "TradingPostSeeds";			String _text = "TP种子与牲畜"; }

		{ String _name = "TradingPostSeedsLwr";			String _text = "TP种子与牲畜"; }

		{ String _name = "TradingPostSeedsTip";			String _text = "允许仅与种子/牲畜商人进行资源交易。尺寸：8x11。花费：48原木、32石头、12铁。容量：30000重量。可存放：木材、石头、铁、燃料、工具、纺织品、衣物、矿物、手工制品、锻造品、织物、工业品、材料、建材、珍贵物品、杂项。雇佣：1-10名商人。提示：牲畜商人和种子商人不接受草药和食物。"; }



		{ String _name = "RKWoodBakery";				String _text = "面包坊"; }

		{ String _name = "RKWoodBakeryLwr";				String _text = "面包坊"; }

		{ String _name = "RKWoodBakeryTip";				String _text = "中世纪面包坊用面粉制作面包、蛋糕和派。尺寸：5x6。花费：32木料、16石头、24木炭、6玻璃。可制作：面包、蛋糕、派、法式咸派、煎蛋卷。雇佣：1-2名面包师。提示：非常适合制作二级食物。面包坊会消耗各种数量的食物和面粉，并尽量给你更多的总食物量（受过教育+100%，未受教育+50%）。有些食物还兼具不止一种饮食类型。"; }



		{ String _name = "NMT30Windmill";				String _text = "风车磨坊"; }

		{ String _name = "NMT30WindmillLwr";				String _text = "风车磨坊"; }

		{ String _name = "NMT30WindmillTip";				String _text = "中世纪风车磨坊用谷物制作面粉。尺寸：6x6。花费：48木料、42石头、32铁。可制作：用小麦、玉米、大麦、高粱、燕麦、黑麦或大米制作面粉。雇佣：1-2名磨坊工。提示：按F键切换其他模型。他们消耗16谷物，产出24-32面粉。（受过教育=+100%，未受教育=+50%）"; }



		{ String _name = "NMT30Watermill";				String _text = "水车磨坊"; }

		{ String _name = "NMT30WatermillLwr";				String _text = "水车磨坊"; }

		{ String _name = "NMT30WatermillTip";				String _text = "中世纪水车磨坊用谷物制作面粉。尺寸：9x7。花费：48木料、42石头、32铁。可制作：用小麦、玉米、大麦、高粱、燕麦、黑麦或大米制作面粉。雇佣：1-3名磨坊工。提示：这座建筑需要一些水域格。工作速度比风车磨坊更快。他们消耗16谷物，产出24-32面粉。（受过教育=+100%，未受教育=+50%）"; }



		{ String _name = "NMT30Apiary";					String _text = "养蜂场"; }

		{ String _name = "NMT30ApiaryLwr";				String _text = "养蜂场"; }

		{ String _name = "NMT30ApiaryTip";				String _text = "中世纪养蜂场用于养蜂并产出蜂蜜与蜂蜡。尺寸：6x6。花费：16原木、24饲料茅草。可制作：蜂蜜（食物）、蜂蜡（用于制蜡烛）。雇佣：1-2名养蜂人。提示：这座食物建筑在游戏早期能提供非常稳定的食物来源。你还需要蜂蜡来制作蜡烛，用于升级你已枯竭的矿场和采石场。"; }



		{ String _name = "WoodButcher";					String _text = "屠夫"; }

		{ String _name = "WoodButcherLwr";				String _text = "屠夫"; }

		{ String _name = "WoodButcherTip";				String _text = "屠夫切割肉类并制作二级食物。尺寸：4x6。花费：48木料、42石头、32铁。可制作：二级加工肉类（肉排、烤肉、排骨及禽肉）。雇佣：1-2名屠夫。提示：这是一座极佳的建筑，可以把你的生肉和生禽肉加工处理，使蛋白质类物资的数量翻倍。12肉可产出18-24肉排（受过教育=+100%）（未受教育仅=+50%）。"; }



		{ String _name = "NMT30LightHouse";				String _text = "灯塔"; }

		{ String _name = "NMT30LightHouseLwr";				String _text = "灯塔"; }

		{ String _name = "NMT30LightHouseTip";				String _text = "灯塔可以提供城镇统计数据，并从远方吸引游民前来。尺寸：11x8。花费：58木料、98石头、14铁、16铜、24玻璃、32柴火。雇佣：1名司炉工。提示：司炉工会照料塔顶的火焰，从而吸引游民。灯塔提供镇政厅所能提供的所有服务。"; }



		{ String _name = "NMT30Watertower";				String _text = "水塔"; }

		{ String _name = "NMT30WatertowerLwr";				String _text = "水塔"; }

		{ String _name = "NMT30WatertowerTip";				String _text = "水塔为你的居民提供淡水。尺寸：4x5。花费：34原木、8铁。可产出：从水塔中获得12-15水。雇佣：1-2名工人。提示：水可作为食物使用，但不含任何营养。一些建筑（如温室）会持续需要水作为投入原料。"; }



		{ String _name = "NMT30Cathedral";				String _text = "大教堂"; }

		{ String _name = "NMT30CathedralLwr";				String _text = "大教堂"; }

		{ String _name = "NMT30CathedralTip";				String _text = "中世纪大教堂为虔诚的信徒提供快乐，并提供一处聚会与礼拜的场所。尺寸：12x20。花费：90木料、160石头、64玻璃、18银、12金、80屋瓦。容量：800灵魂。半径：60格。雇佣：1名神职人员。提示：许多存档都应该有一座宏伟的大教堂！但并非所有存档都需要。"; }



		{ String _name = "NMT30SaltMine";				String _text = "盐矿"; }

		{ String _name = "NMT30SaltMineLwr";				String _text = "盐矿"; }

		{ String _name = "NMT30SaltMineTip";				String _text = "盐矿是一处提供盐的工作场所。尺寸：6x6。花费：24原木、32木料、12铁。可开采：从地下开采4-6盐。影响范围：20格。容量4000，不可更新。雇佣：1-5名矿工。提示：获取盐的更快方式。盐是一种矿物。枯竭后，请拆除并重建一座新的。"; }



		{ String _name = "NMT30OldSmokery";				String _text = "老熏肉坊"; }

		{ String _name = "NMT30OldSmokeryLwr";				String _text = "老熏肉坊"; }

		{ String _name = "NMT30OldSmokeryTip";				String _text = "老熏肉坊是一处将肉类熏制以便保存的工作场所。尺寸：6x6。花费：18木料、48石头、12铁、4玻璃。可制作：二级加工肉类（熏肉、熏鱼及熏禽肉）。雇佣：1-2名面包师。提示：这座建筑每次熏制流程都需要额外1柴火，但产出价值仍保持在3（而非2），鱼为2价值。他们消耗12投入，产出18-24产出。（受过教育=+100%，未受教育=+50%）"; }



		{ String _name = "NMT30OldSaltery";				String _text = "老腌肉坊"; }

		{ String _name = "NMT30OldSalteryLwr";				String _text = "老腌肉坊"; }

		{ String _name = "NMT30OldSalteryTip";				String _text = "老腌肉坊是一处将肉类腌制以便保存的工作场所。尺寸：6x6。花费：36木料、16石头、8铁。可制作：二级加工肉类（咸肉、咸鱼及咸禽肉）。雇佣：1-2名面包师。提示：这座建筑每次腌制流程都需要额外3盐，但产出价值仍保持在3（而非2），鱼为2价值。他们消耗12投入，产出18-24产出。（受过教育=+100%，未受教育=+50%）"; }



		{ String _name = "NMT30DryShack";				String _text = "老晾肉棚"; }

		{ String _name = "NMT30DryShackLwr";				String _text = "老晾肉棚"; }

		{ String _name = "NMT30DryShackTip";				String _text = "老晾肉棚是一处将肉类风干以便保存的工作场所。尺寸：6x6。花费：28木料、6木材、4石头。可制作：二级加工肉类（肉干、鱼干及禽肉干）。雇佣：1-2名面包师。提示：这座建筑只需要肉类，没有其他投入原料，但肉类的价值会下降1点。他们消耗12投入，产出18-24产出。（受过教育=+100%，未受教育=+50%）"; }



		{ String _name = "NMT30Creamery";				String _text = "老乳品坊"; }

		{ String _name = "NMT30CreameryLwr";				String _text = "老乳品坊"; }

		{ String _name = "NMT30CreameryTip";				String _text = "老乳品坊是一处用牛奶制作奶酪、黄油、奶油和酸奶的工作场所。尺寸：8x8。花费：36木料、24石头、8玻璃、6铁。可制作：二级加工肉类（奶酪、黄油、奶油、酸奶）。雇佣：1-2名乳品工。提示：这座建筑主要需要牛奶，你也可以加入一些水果。产出会因配方而变化，教育对产出数量非常重要。"; }



		{ String _name = "RKRedCreamery";				String _text = "红色乳品坊"; }

		{ String _name = "RKRedCreameryLwr";				String _text = "红色乳品坊"; }

		{ String _name = "RKRedCreameryTip";				String _text = "红色乳品坊是一处用牛奶制作奶酪、黄油、奶油和酸奶的工作场所。尺寸：9x10。花费：68木料、12石头、16铜、8玻璃、16玻璃器皿。可制作：二级加工肉类（奶酪、黄油、奶油、酸奶）。雇佣：1-3名乳品工。提示：这座建筑主要需要牛奶，你也可以加入一些水果。产出会因配方而变化，教育对产出数量非常重要。红色乳品坊的速度比老乳品坊快得多。"; }



		{ String _name = "NMT30MaltHouse";				String _text = "麦芽坊"; }

		{ String _name = "NMT30MaltHouseLwr";				String _text = "麦芽坊"; }

		{ String _name = "NMT30MaltHouseTip";				String _text = "麦芽坊是一处将谷物转化为麦芽的工作场所。尺寸：6x8。花费：12原木、24木料、48石头、24砖块、8铁、12玻璃。可制作：用12谷物（大麦、玉米、燕麦、黑麦、高粱、小麦）制作18-24麦芽。雇佣：1-2名酿酒师。提示：旧版麦酒现在价值为6。啤酒已取代麦酒成为价值8的酒类，但啤酒需要麦芽。因此现在你需要先把谷物转化为麦芽，再由酒馆酿造麦芽。"; }



		{ String _name = "NMT30Pond";					String _text = "中世纪池塘"; }

		{ String _name = "NMT30PondLwr";				String _text = "中世纪池塘"; }

		{ String _name = "NMT30PondTip";				String _text = "中世纪池塘为你的居民提供鱼类。尺寸：8x9。花费：4原木、12石头。容量：无限制。提示：与传统渔业码头相比非常独立，这座池塘的产出与之相当。如果你决定移除它，需要使用平地工具将地面恢复正常。"; }



		{ String _name = "StorageBarn";					String _text = "储物谷仓"; }

		{ String _name = "StorageBarnLwr";				String _text = "储物谷仓"; }

		{ String _name = "StorageBarnTip";				String _text = "用于存放食物、衣物、纺织品和工具等物品。尺寸：5x8。花费：48原木、16石头。容量：8000重量。可存放：食物、工具、草药、衣物、纺织品、谷物、蔬菜、水果、蛋白质类、手工制品、锻造品、织物、珍贵物品、杂项。提示：请确保始终留有一些谷仓空间，以存放你的食物和其他物品。"; }



		{ String _name = "NMT30StorageBarnNorm";			String _text = "普通谷仓"; }

		{ String _name = "NMT30StorageBarnNormLwr";			String _text = "普通谷仓"; }

		{ String _name = "NMT30StorageBarnNormTip";			String _text = "普通谷仓用于存放食物、衣物、纺织品和工具等物品。尺寸：5x8。花费：48原木、16石头。容量：10000重量。可存放：食物、工具、草药、衣物、纺织品、谷物、蔬菜、水果、蛋白质类、手工制品、锻造品、织物、珍贵物品、杂项。提示：这座谷仓与游戏内建储物工具栏中的谷仓完全相同。"; }



		{ String _name = "NMT30StorageBarnMed";				String _text = "中型谷仓"; }

		{ String _name = "NMT30StorageBarnMedLwr";			String _text = "中型谷仓"; }

		{ String _name = "NMT30StorageBarnMedTip";			String _text = "中型谷仓用于存放食物、衣物、纺织品和工具等物品。尺寸：4x6。花费：32原木、12石头。容量：6000重量。可存放：食物、工具、草药、衣物、纺织品、谷物、蔬菜、水果、蛋白质类、手工制品、锻造品、织物、珍贵物品、杂项。提示：这座谷仓是普通谷仓的缩小版本，更便宜、尺寸中等，容量也是中等。"; }



