			String _name = "ClearFodder";
			String _text = "采集饲料";
		}
		{
			String _name = "ClearFodderLwr";
			String _text = "采集饲料";
		}
		{
			String _name = "ClearFodderTip";
			String _text = "采集并收集所选区域内的饲料茅草地块。提示：饲料茅草是从地面可见的草地块中采集得到的材料。饲料可用于马厩，可制成柴捆(由伐木工制成柴火)，也可用作建筑材料(养蜂场、无栅栏牧场、饲料谷仓等)。每块草地可产出4-6份饲料茅草(价值1)。这些材料储存在建筑物料堆中。";
		}
		{
			String _name = "ClearFlower";
			String _text = "采集鲜花";
		}
		{
			String _name = "ClearFlowerLwr";
			String _text = "采集鲜花";
		}
		{
			String _name = "ClearFlowerTip";
			String _text = "采集并收集所选区域内生成的鲜花。提示：鲜花带有杂货标记。每丛鲜花可产出3-5朵鲜花(价值1)。请确保您有可接收杂货的谷仓。";
		}
		{
			String _name = "ClearHerb";
			String _text = "采集草药";
		}
		{
			String _name = "ClearHerbLwr";
			String _text = "采集草药";
		}
		{
			String _name = "ClearHerbTip";
			String _text = "采集并收集所选区域内生成的草药。提示：草药在草药师(或浴室)处使用，每次使用可恢复半颗心。每丛草药可产出2-3份草药(价值4)。草药需要谷仓类型的储存设施。";
		}
		{
			String _name = "ClearCopper";
			String _text = "采集铜和锡";
		}
		{
			String _name = "ClearCopperLwr";
			String _text = "采集铜";
		}
		{
			String _name = "ClearCopperTip";
			String _text = "采集所选区域内所有的铜、锡和其他稀有矿物(金和银)。提示：铜用于制作某些工具，也可用作建筑材料。铜和其他稀有矿石都属于矿物。请确保您有可用的物料堆。可开采到2-3份铜矿石(价值4)，1-2份银矿石(价值11)或1-2份金矿石(价值22)。请确保您有可用的矿物堆来储存这些矿石。";
		}
		{
			String _name = "ClearAlmostAll";
			String _text = "采集几乎所有";
		}
		{
			String _name = "ClearAlmostAllLwr";
			String _text = "采集几乎所有";
		}
		{
			String _name = "ClearAlmostAllTip";
			String _text = "采集所选区域内所有的矿石和石头。提示：此特殊工具会收集所有矿石和石头，不会清除树木、草地及其他有价值的野生资源。非常适合快速清理林务员周围的所有土地。";
		}
		{
