		{ String _name = "SherbrookeSawMillTip";				String _text = "Sherbrooke锯木厂将原木加工为木材或薪柴。用于建在水边。请与Sherbrooke锯木厂的桥梁和水坝组件配合使用，以自定义您的磨坊。"; }

