		{ String _name = "ProfessionDairymanTip";		String _text = "乳品工将牛奶送到乳品坊，制作酸奶、奶油和奶酪。"; }
		{ String _name = "ProfessionDairymanDeath";		String _text = "喝了变质的牛奶而死。"; }

		{ String _name = "ProfessionMiller";			String _text = "磨坊工"; }
