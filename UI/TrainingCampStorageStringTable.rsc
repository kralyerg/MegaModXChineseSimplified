		{ String _name = "CitationRKTrainingCamp1Tip";			String _text = "你们是弓，你们的孩子是被射出的生命之箭。——纪伯伦"; }

		{ String _name = "CitationRKTrainingCamp2Tip";			String _text = "每个民族都有自己的旗帜。——阿伊曼·奥德"; }

		{ String _name = "CitationRKTrainingCamp3Tip";			String _text = "攻是守之秘，守是攻之谋。——孙子"; }

		{ String _name = "CitationRKTrainingCamp4Tip";			String _text = "我不认为建筑仅仅是庇护所，仅仅是简单的围合空间。它应当能够让你兴奋，让你平静，让你思考。——扎哈·哈迪德"; }

		{ String _name = "CitationRKTrainingCamp5Tip";			String _text = "人类只有一件真正有效的武器，那就是笑声。——马克·吐温"; }

		{ String _name = "CitationRKTrainingCamp6Tip";			String _text = "世界上最强大的武器，是燃烧着的人类灵魂。——费迪南·福煦"; }

		{ String _name = "CitationRKTrainingCamp7Tip";			String _text = "非暴力是一种强大而正义的武器。——小马丁·路德·金"; }

		{ String _name = "CitationRKTrainingCamp8Tip";			String _text = "井然有序的人生犹如攀登高塔：登到一半时的景色已胜过塔底，随着视野不断开阔，景色也愈发壮美。——威廉·莱昂·费尔普斯"; }

		{ String _name = "CitationRKTrainingCamp9Tip";			String _text = "我无法向你确切证明医疗保健是一项基本人权，但我可以论证：任何人都不应死于一种可以治愈的疾病。——保罗·法默"; }



